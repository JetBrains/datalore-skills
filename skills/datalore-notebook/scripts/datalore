# --------------------------------------------------------------------------- #
# Argument parser
# --------------------------------------------------------------------------- #

def _add_resource_subparser(sub, resource_type, help_text):
    """Add a type-specific resource subparser with standard subcommands."""
    p_res = sub.add_parser(resource_type, help=help_text)
    res_sub = p_res.add_subparsers(dest="resource_command")

    p = res_sub.add_parser("list", help="List all resources")
    add_inheritable_json_flag(p)

    p = res_sub.add_parser("get", help="Get a resource by ID")
    p.add_argument("resource_id", help="Resource UUID")

    if resource_type == "databases":
        p = res_sub.add_parser("drivers", help="List available database drivers")
        add_inheritable_json_flag(p)

    p = res_sub.add_parser("create", help="Create a new resource")
    if resource_type == "databases":
        p.add_argument("--name", required=True, help="Display name")
        p.add_argument("--driver-id", required=True, help="Driver ID")
        p.add_argument("--driver-kind", choices=["predefined", "custom"], default="predefined",
                       help="Driver kind (default: predefined)")
        p.add_argument("--auth-provider-id", default="user-pass", help="Auth provider ID (default: user-pass)")
        p.add_argument("--user-name", help="Database user name")
        p.add_argument("--password", help="Database password")
        p.add_argument("--param", action="append", default=[], metavar="KEY=VALUE",
                       help="Database parameter; repeatable")
        p.add_argument("--param-group-id", type=int, default=0, help="Connection parameter group ID (default: 0)")
        p.add_argument("--additional", action="append", default=[], metavar="KEY=VALUE",
                       help="Database auth/additional property; repeatable")
        p.add_argument("--additional-file", action="append", default=[], metavar="FIELD=PATH",
                       help="Database auth file field; stores FIELD=file name and file content in keys")
        p.add_argument("--key", action="append", default=[], metavar="KEY=VALUE",
                       help="Database key payload entry; repeatable")
        p.add_argument("--key-file", action="append", default=[], metavar="KEY=PATH",
                       help="Database key payload loaded from file; repeatable")
        p.add_argument("--advanced", action="append", default=[], metavar="KEY=VALUE",
                       help="Advanced property; repeatable")
        p.add_argument("--save-tokens", action=argparse.BooleanOptionalAction, default=None,
                       help="Set SaveTokens additional property")
        p.add_argument("--ssh-host", help="SSH tunnel host")
        p.add_argument("--ssh-port", type=int, help="SSH tunnel port (default: 22 when SSH is enabled)")
        p.add_argument("--ssh-user", help="SSH tunnel user")
        p.add_argument("--ssh-password", help="SSH tunnel password")
        p.add_argument("--ssh-key-id", help="SSH key ID for SSH tunnel key-pair auth")
        p.add_argument("--ssh-auth", choices=["password", "key-pair"],
                       help="SSH authentication type; inferred from provided credentials by default")
        p.add_argument("--vm-options", help="JVM options")
        p.add_argument("--use-experimental-session", action=argparse.BooleanOptionalAction, default=True,
                       help="Use experimental SQL session (default: enabled)")
    elif resource_type == "datasources":
        p.add_argument("--name", required=True, help="Display name")
        p.add_argument("--kind", required=True, choices=["S3", "GCS", "GD", "SMB/CIFS"],
                       help="Datasource kind")
        p.add_argument("--field", action="append", default=[], metavar="KEY=VALUE",
                       help="Datasource field; repeatable")
        p.add_argument("--field-file", action="append", default=[], metavar="KEY=PATH",
                       help="Datasource field value loaded from file content; repeatable")
    elif resource_type == "environments":
        p.add_argument("--name", required=True, help="Display name")
        p.add_argument("--variable", action="append", default=[], metavar="KEY=VALUE",
                       help="Environment variable; repeatable")
    elif resource_type == "git-repositories":
        p.add_argument("--name", required=True, help="Display name")
        p.add_argument("--url", required=True, help="Repository URL")
        p.add_argument("--ssh-key-id", help="SSH key ID for SSH repository access")
        p.add_argument("--default-reference", default="HEAD", help="Default git reference (default: HEAD)")
        p.add_argument("--default-reference-type", choices=["head", "branch", "tag", "commit", "unknown"],
                       help="Default reference type (default: head for HEAD, otherwise branch)")
    elif resource_type == "ssh-keys":
        p.add_argument("--name", help="Display name")
        create_mode = p.add_mutually_exclusive_group(required=True)
        create_mode.add_argument("--private-key", help="SSH private key text")
        create_mode.add_argument("--private-key-file", help="Read SSH private key from file")
        create_mode.add_argument("--generate", choices=["rsa", "ed25519"],
                                 help="Generate a new SSH key pair")
    else:
        p.add_argument("resource_json", help="Resource JSON (string or file path)")
    add_inheritable_json_flag(p)

    p = res_sub.add_parser("update", help="Update an existing resource")
    p.add_argument("resource_json", help="Resource JSON with ID (string or file path)")
    add_inheritable_json_flag(p)

    p = res_sub.add_parser("delete", help="Delete a resource")
    p.add_argument("resource_id", help="Resource UUID")
    add_inheritable_json_flag(p)

    p = res_sub.add_parser("search", help="Search resources by name")
    p.add_argument("query", help="Search query (case-insensitive substring)")
    add_inheritable_json_flag(p)

    p = res_sub.add_parser("usage", help="List where a resource is used")
    p.add_argument("resource_id", help="Resource UUID")
    p.add_argument("--match-duplicates", action="store_true", help="Include duplicate usages")
    add_inheritable_json_flag(p)

    p = res_sub.add_parser("clone", help="Clone a resource to current workspace")
    p.add_argument("resource_id", help="Resource UUID to clone")
    p.add_argument("--new-name", help="New name for the cloned resource")


def _add_notebook_resource_attachment_subparser(sub, resource_type, help_text):
    """Add notebook-scoped attachment commands for one resource type."""
    attachment_capabilities = RESOURCE_ATTACHMENT_CAPABILITIES.get(resource_type, {})
    if not any(attachment_capabilities.values()):
        return

    p_res = sub.add_parser(resource_type, help=help_text)
    res_sub = p_res.add_subparsers(dest="notebook_resource_command")

    if attachment_capabilities.get("attached"):
        p = res_sub.add_parser("attached", help="List resources attached to the current notebook")
        p.add_argument("--notebook-id", default=argparse.SUPPRESS,
                       help="Target notebook ID (<ownerId>/<notebookId>); overrides notebook context")
        add_inheritable_json_flag(p)

    if attachment_capabilities.get("get-attached"):
        p = res_sub.add_parser("get-attached", help="Get one resource attachment in the current notebook")
        p.add_argument("resource_id", help="Resource UUID")
        p.add_argument("--notebook-id", default=argparse.SUPPRESS,
                       help="Target notebook ID (<ownerId>/<notebookId>); overrides notebook context")
        add_inheritable_json_flag(p)

    if attachment_capabilities.get("attach"):
        p = res_sub.add_parser("attach", help="Attach a resource to the current notebook")
        p.add_argument("resource_id", help="Resource UUID")
        p.add_argument("--notebook-id", default=argparse.SUPPRESS,
                       help="Target notebook ID (<ownerId>/<notebookId>); overrides notebook context")
        if resource_type in RESOURCE_TYPES_WITH_CUSTOM_ATTACHMENT_OPTIONS:
            p.add_argument(
                "--attachment-options",
                dest="attachment_options_json",
                help="Attachment options JSON object, @file, or '-' from stdin",
            )
        add_inheritable_json_flag(p)

    if attachment_capabilities.get("update-attachment"):
        p = res_sub.add_parser("update-attachment", help="Update resource attachment options in the current notebook")
        p.add_argument("resource_id", help="Resource UUID")
        p.add_argument("--notebook-id", default=argparse.SUPPRESS,
                       help="Target notebook ID (<ownerId>/<notebookId>); overrides notebook context")
        p.add_argument(
            "--attachment-options",
            dest="attachment_options_json",
            required=True,
            help="Attachment options JSON object, @file, or '-' from stdin",
        )
        add_inheritable_json_flag(p)

    if attachment_capabilities.get("detach"):
        p = res_sub.add_parser("detach", help="Detach a resource from the current notebook")
        p.add_argument("resource_id", help="Resource UUID")
        p.add_argument("--notebook-id", default=argparse.SUPPRESS,
                       help="Target notebook ID (<ownerId>/<notebookId>); overrides notebook context")
        add_inheritable_json_flag(p)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="datalore",
        description="Datalore CLI — manage sessions, workspaces, notebook content, and workspace resources.",
    )
    parser.add_argument("--json", action="store_true", help="Output raw JSON responses")
    parser.add_argument("--verbose", action="store_true", help="Print HTTP requests to stderr")

    sub = parser.add_subparsers(dest="command")

    # -- init ---------------------------------------------------------------- #
    p = sub.add_parser("init", help="Initialize a session from a notebook, workspace, or host URL")
    p.add_argument(
        "url",
        help=(
            "Target URL. Use a notebook URL for notebook_api or notebook_with_workspace_view, a workspace URL for "
            "workspace scope, and the host root URL for user_basic."
        ),
    )
    p.add_argument(
        "--scope",
        choices=sorted(SUPPORTED_OAUTH_SCOPES),
        default=NOTEBOOK_API_SCOPE,
        help=f"Authorization scope (default: {NOTEBOOK_API_SCOPE})",
    )
    p.add_argument("--workspace-id", help="Workspace ID (<ownerId>/<workspaceId>) for workspace scopes")
    p.add_argument("--notebook-id", help="Optional notebook context (<ownerId>/<notebookId>) for workspace scope")
    p.add_argument(
        "--access",
        choices=sorted(SUPPORTED_AUTH_ACCESS),
        default=DEFAULT_AUTH_ACCESS.lower(),
        help=f"Authorization access for workspace scope (default: {DEFAULT_AUTH_ACCESS.lower()})",
    )
    p.add_argument("--api-token-stdin", action="store_true",
                   help="Read API token from stdin instead of prompting")

    # -- logout -------------------------------------------------------------- #
    p = sub.add_parser("logout", help="Delete saved credentials and the current session file")
    p.add_argument("url", nargs="?", help="Scope-dependent URL (defaults to current .datalore-session)")
    p.add_argument(
        "--scope",
        choices=sorted(SUPPORTED_OAUTH_SCOPES),
        default=NOTEBOOK_API_SCOPE,
        help=f"Credential scope to delete when --url is provided (default: {NOTEBOOK_API_SCOPE})",
    )
    p.add_argument("--workspace-id", help="Workspace ID (<ownerId>/<workspaceId>) for workspace scopes")
    p.add_argument(
        "--access",
        choices=sorted(SUPPORTED_AUTH_ACCESS),
        default=DEFAULT_AUTH_ACCESS.lower(),
        help=f"Authorization access for workspace scope (default: {DEFAULT_AUTH_ACCESS.lower()})",
    )

    # -- workspaces ---------------------------------------------------------- #
    sub.add_parser("workspaces", help="List own workspaces")

    # -- workspace ----------------------------------------------------------- #
    p_workspace = sub.add_parser("workspace", help="Workspace-scoped operations and resources")
    p_workspace.add_argument(
        "--workspace-id",
        help="Target workspace ID (<ownerId>/<workspaceId>); overrides workspace context for any workspace command",
    )
    workspace_sub = p_workspace.add_subparsers(dest="workspace_command")

    workspace_sub.add_parser("info", help="Show current workspace metadata")
    workspace_sub.add_parser("entries", help="List direct entries of the current workspace")
    workspace_sub.add_parser("reports", help="List all reports in the current workspace")
    p = workspace_sub.add_parser("file", help="Show file/notebook metadata")
    p.add_argument("entity_id", help="Entity ID (<ownerId>/<entityId>)")
    p = workspace_sub.add_parser("breadcrumbs", help="Show breadcrumbs for an entity")
    p.add_argument("entity_id", help="Entity ID (<ownerId>/<entityId>)")
    p = workspace_sub.add_parser("folder", help="Show folder metadata, breadcrumb, and direct children")
    p.add_argument("folder_id", help="Folder ID (<ownerId>/<folderId>)")
    p = workspace_sub.add_parser("folder-entries", help="List direct entries of a folder in the current workspace")
    p.add_argument("folder_id", help="Folder ID (<ownerId>/<folderId>)")
    p = workspace_sub.add_parser("mkdir", help="Create a folder in the current workspace")
    p.add_argument("name", help="Folder name")
    p.add_argument("--parent", dest="parent_id", help="Parent folder ID (<ownerId>/<folderId>)")
    p = workspace_sub.add_parser("create-notebook", help="Create a notebook in the current workspace")
    p.add_argument("name", help="Notebook name")
    p.add_argument("--parent", dest="parent_id", help="Parent folder ID (<ownerId>/<folderId>)")
    p.add_argument("--language", default="python", help="Notebook language (default: python)")
    p = workspace_sub.add_parser("rename", help="Rename a notebook or folder")
    p.add_argument("entity_id", help="Entity ID (<ownerId>/<entityId>)")
    p.add_argument("name", help="New name")
    p = workspace_sub.add_parser("move", help="Move a notebook or folder")
    p.add_argument("entity_id", help="Entity ID (<ownerId>/<entityId>)")
    p.add_argument("parent_id", help="Destination folder ID (<ownerId>/<folderId>)")
    p = workspace_sub.add_parser("move-to-trash", help="Move an entity to trash")
    p.add_argument("entity_id", help="Entity ID (<ownerId>/<entityId>)")
    p = workspace_sub.add_parser("remove-from-trash", help="Permanently remove an entity from trash")
    p.add_argument("entity_id", help="Entity ID (<ownerId>/<entityId>)")
    p = workspace_sub.add_parser("restore-from-trash", help="Restore an entity from trash")
    p.add_argument("entity_id", help="Entity ID (<ownerId>/<entityId>)")
    workspace_sub.add_parser("empty-trash", help="Permanently remove all trash contents")

    p_database = workspace_sub.add_parser("database", help="Workspace database query operations")
    database_sub = p_database.add_subparsers(dest="database_command")
    p = database_sub.add_parser("query", help="Execute SQL and write the CSV result to stdout")
    p.add_argument(
        "--workspace-id",
        default=argparse.SUPPRESS,
        help="Target workspace ID (<ownerId>/<workspaceId>); overrides workspace context",
    )
    p.add_argument("--database-id", required=True, help="Database ID")
    p.add_argument("--name", required=True, help="Name for the created query")
    p.add_argument("--query", required=True, help="SQL query string")

    # -- workspace resources ------------------------------------------------- #
    _add_resource_subparser(
        workspace_sub,
        "databases",
        "Workspace database resources (not notebook-attached databases)",
    )
    _add_resource_subparser(workspace_sub, "datasources", "Workspace datasources")
    _add_resource_subparser(workspace_sub, "environments", "Workspace environments")
    _add_resource_subparser(workspace_sub, "git-repositories", "Workspace git repositories")
    _add_resource_subparser(workspace_sub, "ssh-keys", "Workspace SSH keys")

    # -- notebook ------------------------------------------------------------ #
    p_notebook = sub.add_parser("notebook", help="Notebook-scoped operations")
    p_notebook.add_argument(
        "--notebook-id",
        help="Target notebook ID (<ownerId>/<notebookId>); overrides notebook context for any notebook command",
    )
    notebook_sub = p_notebook.add_subparsers(dest="notebook_command")

    # -- notebook cells ------------------------------------------------------ #
    p_cells = notebook_sub.add_parser("cells", help="List or run notebook cells")
    p_cells.add_argument("--full", action="store_true", help="Include cell source code")
    p_cells.add_argument("--worksheet-index", type=int, help="Worksheet tab index (default: 0)")
    p_cells.add_argument("--include-outputs", action="store_true",
                         help="Fetch statuses and outputs for all listed cells")
    cells_sub = p_cells.add_subparsers(dest="cells_command")

    p = cells_sub.add_parser("run", help="Execute cells in order")
    p.add_argument("cell_ids", nargs="+", help="Cell IDs to run")
    p.add_argument("--stop-on-error", action=argparse.BooleanOptionalAction, default=None,
                   help="Stop after first ERROR status (default: true)")
    p.add_argument("--timeout-ms", type=int, default=30000,
                   help="Per-cell API wait timeout in ms (max 30000)")

    # -- cell ---------------------------------------------------------------- #
    p_cell = notebook_sub.add_parser("cell", help="Notebook cell operations")
    cell_sub = p_cell.add_subparsers(dest="cell_command")

    # cell get
    p = cell_sub.add_parser("get", help="Get cell with status and outputs")
    p.add_argument("cell_id", help="Cell ID")

    # cell create
    p = cell_sub.add_parser("create", help="Create cell (source from stdin)")
    p.add_argument("--type", default="CODE", choices=["CODE", "MARKDOWN", "SQL", "CONTROL"],
                   help="Cell type (default: CODE)")
    p.add_argument("--language", default="python",
                   help="Language for CODE cells (default: python)")
    p.add_argument("--after", dest="after_cell_id", help="Insert after this cell ID")
    p.add_argument("--before", dest="before_cell_id", help="Insert before this cell ID")
    p.add_argument("--database-id", dest="database_id", help="Database ID for SQL cells")
    p.add_argument("--variable", dest="variable_name",
                   help="DataFrame variable name for SQL cells")
    p.add_argument("--data-json", dest="data_json",
                   help="Cell data JSON object, or @file, for advanced cell metadata")
    p.add_argument("--control-json", dest="control_json",
                   help="Control JSON object, @file, or '-' for CONTROL cells")
    p.add_argument("--source", dest="source", help="Cell source (alternative to stdin)")
    p.add_argument("--run", action="store_true", help="Execute after creation")
    p.add_argument("--wait", action="store_true",
                   help="For CODE, SQL, and CONTROL cells, run after creation and wait for completion")
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help=f"Max wait seconds (default: {DEFAULT_TIMEOUT})")

    # cell edit
    p = cell_sub.add_parser("edit", help="Edit cell (new source from stdin)")
    p.add_argument("cell_id", help="Cell ID")
    p.add_argument("--source", dest="source", help="New source (alternative to stdin)")
    p.add_argument("--database-id", dest="database_id", help="Database ID for SQL cells")
    p.add_argument("--variable", dest="variable_name",
                   help="DataFrame variable name for SQL cells")
    p.add_argument("--data-json", dest="data_json",
                   help="SQL cell data JSON object, or @file")
    p.add_argument("--run", action="store_true", help="Execute after editing")
    p.add_argument("--wait", action="store_true",
                   help="For CODE and SQL cells, run after editing and wait for completion")
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help=f"Max wait seconds (default: {DEFAULT_TIMEOUT})")

    # cell run
    p = cell_sub.add_parser("run", help="Execute a cell")
    p.add_argument("cell_id", help="Cell ID")
    p.add_argument("--wait", action="store_true", help="Wait for execution to complete")
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help=f"Max wait seconds (default: {DEFAULT_TIMEOUT})")

    # cell outputs
    p = cell_sub.add_parser("outputs", help="Get cell outputs")
    p.add_argument("cell_id", help="Cell ID")

    # cell delete
    p = cell_sub.add_parser("delete", help="Delete a cell")
    p.add_argument("cell_id", help="Cell ID")

    # cell update-control
    p = cell_sub.add_parser("update-control", help="Update a control cell")
    p.add_argument("cell_id", help="Cell ID")
    p.add_argument("--control-json", dest="control_json", required=True,
                   help="Control JSON object, @file, or '-' from stdin")
    p.add_argument("--run", action="store_true", help="Execute after updating")
    p.add_argument("--wait", action="store_true",
                   help="Wait for execution to complete (implies --run)")
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help=f"Max wait seconds (default: {DEFAULT_TIMEOUT})")

    # -- files --------------------------------------------------------------- #
    p = notebook_sub.add_parser("files", help="List notebook files")
    p.add_argument("--directory", help="Directory to list (default: root)")

    # -- file ---------------------------------------------------------------- #
    p_file = notebook_sub.add_parser("file", help="Notebook file operations")
    file_sub = p_file.add_subparsers(dest="file_command")

    p = file_sub.add_parser("read", help="Download file to stdout")
    p.add_argument("path", help="File path (e.g. data/notebook_files/data.csv)")

    p = file_sub.add_parser("download", help="Download file to stdout")
    p.add_argument("path", help="File path (e.g. data/notebook_files/data.csv)")

    p = file_sub.add_parser("text", help="Read file as text")
    p.add_argument("path", help="File path")
    p.add_argument("--encoding", help="Text encoding (default: utf-8, then latin-1 fallback)")
    p.add_argument("--max-bytes", type=int, help="Maximum bytes to read")
    p.add_argument("--max-lines", type=int, help="Maximum lines to read")

    p = file_sub.add_parser("upload", help="Upload a local file")
    p.add_argument("local_path", help="Path to local file")
    p.add_argument("--directory", help="Target directory in notebook")

    p = file_sub.add_parser("delete", help="Delete a file")
    p.add_argument("path", help="File path")

    p = file_sub.add_parser("exists", help="Check if file exists")
    p.add_argument("path", help="File path")

    # -- attached-databases -------------------------------------------------- #
    p = notebook_sub.add_parser(
        "attached-databases",
        help="List databases, attached to the notebook",
    )

    _add_notebook_resource_attachment_subparser(
        notebook_sub,
        "databases",
        "Notebook database attachments",
    )
    _add_notebook_resource_attachment_subparser(
        notebook_sub,
        "datasources",
        "Notebook datasource attachments",
    )
    _add_notebook_resource_attachment_subparser(
        notebook_sub,
        "environments",
        "Notebook environment attachments",
    )
    _add_notebook_resource_attachment_subparser(
        notebook_sub,
        "git-repositories",
        "Notebook git repository attachments",
    )

    # -- db ------------------------------------------------------------------ #
    p_db = notebook_sub.add_parser("db", help="Attached database schema operations")
    db_sub = p_db.add_subparsers(dest="db_command")

    p = db_sub.add_parser("schema", help="Browse schema tree")
    p.add_argument("database_id", help="Database ID")
    p.add_argument("--path", help="Dot-separated path (e.g. public.tables.users)")
    p.add_argument("--depth", type=int, help="Levels of children to include (default: 1)")
    p.add_argument("--verbosity", choices=["essential", "standard", "full"],
                   help="Schema verbosity level")

    p = db_sub.add_parser("search", help="Search schema by name")
    p.add_argument("database_id", help="Database ID")
    p.add_argument("query", help="Search query (case-insensitive substring)")
    p.add_argument("--kinds", help="Comma-separated kinds filter (e.g. TABLE,VIEW)")
    p.add_argument("--limit", type=int, help="Max results (default: 50)")
    p.add_argument("--verbosity", choices=["essential", "standard", "full"],
                   help="Schema verbosity level")

    p = db_sub.add_parser("condensed", help="Print compact schema text")
    p.add_argument("database_id", help="Database ID")

    # -- kernel -------------------------------------------------------------- #
    p_kernel = notebook_sub.add_parser("kernel", help="Notebook kernel operations")
    kernel_sub = p_kernel.add_subparsers(dest="kernel_command")

    kernel_sub.add_parser("status", help="Check kernel state")
    p = kernel_sub.add_parser("restart", help="Restart kernel")
    p.add_argument("--reinstall-environment", action="store_true",
                   help="Reinstall environment during restart")
    p.add_argument("--wait", action="store_true", help="Wait until kernel is ready")
    p.add_argument("--timeout-ms", type=int, default=30000,
                   help="Kernel restart wait timeout in ms")
    kernel_sub.add_parser("interrupt", help="Interrupt execution")

    # -- agent --------------------------------------------------------------- #
    p_agent = notebook_sub.add_parser("agent", help="Notebook agent operations")
    agent_sub = p_agent.add_subparsers(dest="agent_command")
    agent_sub.add_parser("stop", help="Stop the notebook agent")

    # -- worksheet ----------------------------------------------------------- #
    p_worksheet = notebook_sub.add_parser("worksheet", help="Notebook worksheet operations")
    worksheet_sub = p_worksheet.add_subparsers(dest="worksheet_command")
    p = worksheet_sub.add_parser("create", help="Create a worksheet tab")
    p.add_argument("--name", help="Worksheet name")
    p.add_argument("--worksheet-index", type=int, help="Insert at worksheet tab index")

    # -- report -------------------------------------------------------------- #
    p_report = notebook_sub.add_parser("report", help="Notebook report layout and publication")
    report_sub = p_report.add_subparsers(dest="report_command")
    report_sub.add_parser("get", help="Get the current report layout")

    p = report_sub.add_parser("replace", help="Replace the complete report layout")
    p.add_argument("--tabs-json", required=True, help="Tabs JSON array, @file, or '-' from stdin")

    p = report_sub.add_parser("add-tab", help="Add a report tab")
    p.add_argument("--name", default="", help="Tab name (default: empty)")
    p.add_argument("--tab-id", help="Tab ID; generated when omitted")
    p.add_argument("--index", type=int, help="Zero-based insertion index (default: append)")
    p.set_defaults(report_operation_type="ADD_TAB", report_operation_fields={"tab_id": "tabId", "name": "name", "index": "index"})

    p = report_sub.add_parser("rename-tab", help="Rename a report tab")
    p.add_argument("tab_id", help="Tab ID")
    p.add_argument("name", help="New tab name")
    p.set_defaults(report_operation_type="RENAME_TAB", report_operation_fields={"tab_id": "tabId", "name": "name"})

    p = report_sub.add_parser("move-tab", help="Move a report tab")
    p.add_argument("tab_id", help="Tab ID")
    p.add_argument("index", type=int, help="Zero-based destination index")
    p.set_defaults(report_operation_type="MOVE_TAB", report_operation_fields={"tab_id": "tabId", "index": "index"})

    p = report_sub.add_parser("remove-tab", help="Remove a report tab and its rows")
    p.add_argument("tab_id", help="Tab ID")
    p.set_defaults(report_operation_type="REMOVE_TAB", report_operation_fields={"tab_id": "tabId"})

    p = report_sub.add_parser("add-row", help="Add a row to a report tab")
    p.add_argument("tab_id", help="Owning tab ID")
    p.add_argument("--row-id", help="Row ID; generated when omitted")
    p.add_argument("--index", type=int, help="Zero-based insertion index (default: append)")
    p.set_defaults(report_operation_type="ADD_ROW", report_operation_fields={"tab_id": "tabId", "row_id": "rowId", "index": "index"})

    p = report_sub.add_parser("move-row", help="Move a report row to a tab and index")
    p.add_argument("row_id", help="Row ID")
    p.add_argument("tab_id", help="Destination tab ID")
    p.add_argument("index", type=int, help="Zero-based destination index")
    p.set_defaults(report_operation_type="MOVE_ROW", report_operation_fields={"row_id": "rowId", "tab_id": "tabId", "index": "index"})

    p = report_sub.add_parser("remove-row", help="Remove a report row and its cells")
    p.add_argument("row_id", help="Row ID")
    p.set_defaults(report_operation_type="REMOVE_ROW", report_operation_fields={"row_id": "rowId"})

    p = report_sub.add_parser("upsert-cell", help="Add or move a cell in a report row")
    p.add_argument("row_id", help="Target row ID")
    p.add_argument(
        "--cell-json",
        required=True,
        help="Cell layout JSON object, @file, or '-' from stdin; omit height for dynamic sizing; fixed vertical values are grid-step counts",
    )

    p = report_sub.add_parser("remove-cell", help="Remove a cell from the report")
    p.add_argument("cell_id", help="Notebook cell ID")
    p.set_defaults(report_operation_type="REMOVE_CELL", report_operation_fields={"cell_id": "cellId"})

    p = report_sub.add_parser("publish", help="Create or update a static or interactive report")
    p.add_argument("--type", required=True, choices=["STATIC", "INTERACTIVE"], help="Report type")
    p.add_argument("--mode", required=True, choices=["CREATE", "UPDATE"], help="Publication mode")
    p.add_argument("--full-width", action=argparse.BooleanOptionalAction, default=True, help="Use full report width (default: true)")
    p.add_argument("--computation-mode", choices=["REACTIVE", "JUPYTER"], help="Interactive report computation mode")
    p.add_argument("--can-download-and-edit-copy", action="store_true", help="Allow viewers to download and edit a copy")

    # -- definitions --------------------------------------------------------- #
    p = notebook_sub.add_parser("definitions", help="Go to definition in the current notebook")
    p.add_argument("cell_id", help="Cell ID")
    p.add_argument("line", type=int, help="1-based line")
    p.add_argument("column", type=int, help="1-based column")

    return parser


# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #

