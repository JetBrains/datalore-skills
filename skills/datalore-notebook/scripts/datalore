def cmd_db_schema(args):
    session = load_session()
    payload = {
        "notebookId": session.notebook_id_dict(),
        "databaseId": args.database_id,
    }
    if args.path:
        payload["path"] = args.path.split(".")
    else:
        payload["path"] = []
    if args.depth:
        payload["depth"] = args.depth
    if args.verbosity:
        payload["verbosity"] = args.verbosity

    body = notebook_api_post(session, "/database/schema/children", payload)

    if args.json:
        print_json(body)
        return

    _print_schema_tree(body.get("children", []), indent=0)
    errors = body.get("errors")
    if errors:
        print(f"\nWarning: {errors}", file=sys.stderr)


def _print_schema_tree(children, indent):
    prefix = "  " * indent
    for child in children:
        name = child.get("name", "?")
        kind = child.get("kind", "")
        info = child.get("info", "")
        desc_count = child.get("descendantCount", 0)

        label = f"{prefix}{name}"
        if kind:
            label += f"  ({kind})"
        if info:
            label += f"  {info}"
        if desc_count > 0 and not child.get("children"):
            label += f"  [{desc_count} descendants]"
        print(label)

        sub = child.get("children", [])
        if sub:
            _print_schema_tree(sub, indent + 1)


def cmd_db_search(args):
    session = load_session()
    payload = {
        "notebookId": session.notebook_id_dict(),
        "databaseId": args.database_id,
        "query": args.query,
    }
    if args.kinds:
        payload["kinds"] = [k.strip() for k in args.kinds.split(",")]
    if args.limit:
        payload["limit"] = args.limit
    if args.verbosity:
        payload["verbosity"] = args.verbosity

    body = notebook_api_post(session, "/database/schema/search", payload)

    if args.json:
        print_json(body)
        return

    results = body.get("results", [])
    total = body.get("totalMatches", len(results))
    truncated = body.get("truncated", False)

    if not results:
        print("No matches.")
        return

    for r in results:
        path_str = ".".join(r.get("path", []))
        kind = r.get("kind", "")
        print(f"  {r.get('name', '?')}  ({kind})  path: {path_str}")

    if truncated:
        print(f"\n  Showing {len(results)} of {total} matches (truncated).")


