def cmd_databases(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict()}
    body = api_post(session, "/databases", payload)

    if args.json:
        print_json(body)
        return

    databases = body.get("databases", [])
    if not databases:
        print("No databases attached.")
        return
    for db in databases:
        schema_indicator = " (schema available)" if db.get("hasSchema") else ""
        print(f"  {db.get('databaseId', '?')}  {db.get('name', '?')} [{db.get('driver', '?')}]{schema_indicator}")


def cmd_db_schema(args):
    session = load_session()
    payload = {
        "notebookId": session.notebook_id_dict(),
        "databaseId": args.database_id,
    }
    if args.path:
        payload["path"] = args.path.split(".")
    else:
        payload["path"] = []
    if args.depth:
        payload["depth"] = args.depth
    if args.verbosity:
        payload["verbosity"] = args.verbosity

    body = api_post(session, "/database/schema/children", payload)

    if args.json:
        print_json(body)
        return

    _print_schema_tree(body.get("children", []), indent=0)
    errors = body.get("errors")
    if errors:
        print(f"\nWarning: {errors}", file=sys.stderr)


def _print_schema_tree(children, indent):
    prefix = "  " * indent
    for child in children:
        name = child.get("name", "?")
        kind = child.get("kind", "")
        info = child.get("info", "")
        desc_count = child.get("descendantCount", 0)

        label = f"{prefix}{name}"
        if kind:
            label += f"  ({kind})"
        if info:
            label += f"  {info}"
        if desc_count > 0 and not child.get("children"):
            label += f"  [{desc_count} descendants]"
        print(label)

        sub = child.get("children", [])
        if sub:
            _print_schema_tree(sub, indent + 1)


def cmd_db_search(args):
    session = load_session()
    payload = {
        "notebookId": session.notebook_id_dict(),
        "databaseId": args.database_id,
        "query": args.query,
    }
    if args.kinds:
        payload["kinds"] = [k.strip() for k in args.kinds.split(",")]
    if args.limit:
        payload["limit"] = args.limit
    if args.verbosity:
        payload["verbosity"] = args.verbosity

    body = api_post(session, "/database/schema/search", payload)

    if args.json:
        print_json(body)
        return

    results = body.get("results", [])
    total = body.get("totalMatches", len(results))
    truncated = body.get("truncated", False)

    if not results:
        print("No matches.")
        return

    for r in results:
        path_str = ".".join(r.get("path", []))
        kind = r.get("kind", "")
        print(f"  {r.get('name', '?')}  ({kind})  path: {path_str}")

    if truncated:
        print(f"\n  Showing {len(results)} of {total} matches (truncated).")


def cmd_db_condensed(args):
    session = load_session()
    payload = {
        "notebookId": session.notebook_id_dict(),
        "databaseId": args.database_id,
    }
    body = api_post(session, "/database/schema/condensed", payload)

    if args.json:
        print_json(body)
        return

    print(body.get("schema", ""))


# -- Kernel --------------------------------------------------------------- #

def cmd_kernel_status(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict()}
    body = api_post(session, "/kernel/status", payload)

    if args.json:
        print_json(body)
        return

    state = body.get("state", "?")
    running = body.get("runningCellId")
    print(f"Kernel: {state}")
    if running:
        print(f"Running cell: {running}")


def cmd_kernel_restart(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict()}
    if args.reinstall_environment:
        payload["reinstallEnvironment"] = True
    if args.wait:
        payload["waitUntilReady"] = True
        payload["waitTimeoutMs"] = args.timeout_ms

    body = api_post(
        session,
        "/kernel/restart",
        payload,
        timeout=request_timeout_for_server_wait(args.timeout_ms) if args.wait else None,
    )

    if args.json:
        print_json(body)
        return

    print(f"Kernel: {body.get('state', '?')}")
    if body.get("timedOut"):
        print("Restart timed out before the kernel became ready.", file=sys.stderr)
        sys.exit(2)


def cmd_kernel_interrupt(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict()}
    body = api_post(session, "/kernel/interrupt", payload)

    if args.json:
        print_json(body)
        return

    interrupted = body.get("interrupted", False)
    print("Interrupted running cell." if interrupted else "No running cell to interrupt.")


# --------------------------------------------------------------------------- #
# Argument parser
# --------------------------------------------------------------------------- #

def build_parser():
    parser = argparse.ArgumentParser(
        prog="datalore",
        description="Datalore notebook CLI — manage cells, files, and databases.",
    )
    parser.add_argument("--json", action="store_true", help="Output raw JSON responses")
    parser.add_argument("--verbose", action="store_true", help="Print HTTP requests to stderr")

    sub = parser.add_subparsers(dest="command")

    # -- init ---------------------------------------------------------------- #
    p = sub.add_parser("init", help="Initialize session from notebook URL")
    p.add_argument("url", help="Notebook URL (https://<host>/notebook/<owner>/<id>/...)")
    p.add_argument("--api-token-stdin", action="store_true",
                   help="Read API token from stdin instead of prompting")

    # -- cells --------------------------------------------------------------- #
    p_cells = sub.add_parser("cells", help="List or run notebook cells")
    p_cells.add_argument("--full", action="store_true", help="Include cell source code")
    p_cells.add_argument("--worksheet-index", type=int, help="Worksheet tab index (default: 0)")
    p_cells.add_argument("--include-outputs", action="store_true",
                         help="Fetch statuses and outputs for all listed cells")
    cells_sub = p_cells.add_subparsers(dest="cells_command")

    p = cells_sub.add_parser("run", help="Execute cells in order")
    p.add_argument("cell_ids", nargs="+", help="Cell IDs to run")
    p.add_argument("--stop-on-error", action=argparse.BooleanOptionalAction, default=None,
                   help="Stop after first ERROR status (default: true)")
    p.add_argument("--timeout-ms", type=int, default=30000,
                   help="Per-cell API wait timeout in ms (max 30000)")

    # -- cell ---------------------------------------------------------------- #
    p_cell = sub.add_parser("cell", help="Cell operations")
    cell_sub = p_cell.add_subparsers(dest="cell_command")

    # cell get
    p = cell_sub.add_parser("get", help="Get cell with status and outputs")
    p.add_argument("cell_id", help="Cell ID")

    # cell create
    p = cell_sub.add_parser("create", help="Create cell (source from stdin)")
    p.add_argument("--type", default="CODE", choices=["CODE", "MARKDOWN", "SQL", "CONTROL"],
                   help="Cell type (default: CODE)")
    p.add_argument("--language", default="python",
                   help="Language for CODE cells (default: python)")
    p.add_argument("--after", dest="after_cell_id", help="Insert after this cell ID")
    p.add_argument("--before", dest="before_cell_id", help="Insert before this cell ID")
    p.add_argument("--database-id", dest="database_id", help="Database ID for SQL cells")
    p.add_argument("--variable", dest="variable_name",
                   help="DataFrame variable name for SQL cells")
    p.add_argument("--data-json", dest="data_json",
                   help="Cell data JSON object, or @file, for advanced cell metadata")
    p.add_argument("--control-json", dest="control_json",
                   help="Control JSON object, @file, or '-' for CONTROL cells")
    p.add_argument("--source", dest="source", help="Cell source (alternative to stdin)")
    p.add_argument("--run", action="store_true", help="Execute after creation")
    p.add_argument("--wait", action="store_true",
                   help="For CODE, SQL, and CONTROL cells, run after creation and wait for completion")
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help=f"Max wait seconds (default: {DEFAULT_TIMEOUT})")

    # cell edit
    p = cell_sub.add_parser("edit", help="Edit cell (new source from stdin)")
    p.add_argument("cell_id", help="Cell ID")
    p.add_argument("--source", dest="source", help="New source (alternative to stdin)")
    p.add_argument("--database-id", dest="database_id", help="Database ID for SQL cells")
    p.add_argument("--variable", dest="variable_name",
                   help="DataFrame variable name for SQL cells")
    p.add_argument("--data-json", dest="data_json",
                   help="SQL cell data JSON object, or @file")
    p.add_argument("--run", action="store_true", help="Execute after editing")
    p.add_argument("--wait", action="store_true",
                   help="For CODE and SQL cells, run after editing and wait for completion")
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help=f"Max wait seconds (default: {DEFAULT_TIMEOUT})")

    # cell run
    p = cell_sub.add_parser("run", help="Execute a cell")
    p.add_argument("cell_id", help="Cell ID")
    p.add_argument("--wait", action="store_true", help="Wait for execution to complete")
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help=f"Max wait seconds (default: {DEFAULT_TIMEOUT})")

    # cell outputs
    p = cell_sub.add_parser("outputs", help="Get cell outputs")
    p.add_argument("cell_id", help="Cell ID")

    # cell delete
    p = cell_sub.add_parser("delete", help="Delete a cell")
    p.add_argument("cell_id", help="Cell ID")

    # cell update-control
    p = cell_sub.add_parser("update-control", help="Update a control cell")
    p.add_argument("cell_id", help="Cell ID")
    p.add_argument("--control-json", dest="control_json", required=True,
                   help="Control JSON object, @file, or '-' from stdin")
    p.add_argument("--run", action="store_true", help="Execute after updating")
    p.add_argument("--wait", action="store_true",
                   help="Wait for execution to complete (implies --run)")
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help=f"Max wait seconds (default: {DEFAULT_TIMEOUT})")

    # -- files --------------------------------------------------------------- #
    p = sub.add_parser("files", help="List files")
    p.add_argument("--directory", help="Directory to list (default: root)")

    # -- file ---------------------------------------------------------------- #
    p_file = sub.add_parser("file", help="File operations")
    file_sub = p_file.add_subparsers(dest="file_command")

    p = file_sub.add_parser("read", help="Download file to stdout")
    p.add_argument("path", help="File path (e.g. data/notebook_files/data.csv)")

    p = file_sub.add_parser("download", help="Download file to stdout")
    p.add_argument("path", help="File path (e.g. data/notebook_files/data.csv)")

    p = file_sub.add_parser("text", help="Read file as text")
    p.add_argument("path", help="File path")
    p.add_argument("--encoding", help="Text encoding (default: utf-8, then latin-1 fallback)")
    p.add_argument("--max-bytes", type=int, help="Maximum bytes to read")
    p.add_argument("--max-lines", type=int, help="Maximum lines to read")

    p = file_sub.add_parser("upload", help="Upload a local file")
    p.add_argument("local_path", help="Path to local file")
    p.add_argument("--directory", help="Target directory in notebook")

    p = file_sub.add_parser("delete", help="Delete a file")
    p.add_argument("path", help="File path")

    p = file_sub.add_parser("exists", help="Check if file exists")
    p.add_argument("path", help="File path")

    # -- databases ----------------------------------------------------------- #
    p = sub.add_parser("databases", help="List attached databases")

    # -- db ------------------------------------------------------------------ #
    p_db = sub.add_parser("db", help="Database operations")
    db_sub = p_db.add_subparsers(dest="db_command")

    p = db_sub.add_parser("schema", help="Browse schema tree")
    p.add_argument("database_id", help="Database ID")
    p.add_argument("--path", help="Dot-separated path (e.g. public.tables.users)")
    p.add_argument("--depth", type=int, help="Levels of children to include (default: 1)")
    p.add_argument("--verbosity", choices=["essential", "standard", "full"],
                   help="Schema verbosity level")

    p = db_sub.add_parser("search", help="Search schema by name")
    p.add_argument("database_id", help="Database ID")
    p.add_argument("query", help="Search query (case-insensitive substring)")
    p.add_argument("--kinds", help="Comma-separated kinds filter (e.g. TABLE,VIEW)")
    p.add_argument("--limit", type=int, help="Max results (default: 50)")
    p.add_argument("--verbosity", choices=["essential", "standard", "full"],
                   help="Schema verbosity level")

    p = db_sub.add_parser("condensed", help="Print compact schema text")
    p.add_argument("database_id", help="Database ID")

    # -- kernel -------------------------------------------------------------- #
    p_kernel = sub.add_parser("kernel", help="Kernel operations")
    kernel_sub = p_kernel.add_subparsers(dest="kernel_command")

    kernel_sub.add_parser("status", help="Check kernel state")
    p = kernel_sub.add_parser("restart", help="Restart kernel")
    p.add_argument("--reinstall-environment", action="store_true",
                   help="Reinstall environment during restart")
    p.add_argument("--wait", action="store_true", help="Wait until kernel is ready")
    p.add_argument("--timeout-ms", type=int, default=30000,
                   help="Kernel restart wait timeout in ms")
    kernel_sub.add_parser("interrupt", help="Interrupt execution")

    # -- worksheet ----------------------------------------------------------- #
    p_worksheet = sub.add_parser("worksheet", help="Worksheet operations")
    worksheet_sub = p_worksheet.add_subparsers(dest="worksheet_command")
    p = worksheet_sub.add_parser("create", help="Create a worksheet tab")
    p.add_argument("--name", help="Worksheet name")
    p.add_argument("--worksheet-index", type=int, help="Insert at worksheet tab index")

    # -- definitions --------------------------------------------------------- #
    p = sub.add_parser("definitions", help="Go to definition")
    p.add_argument("cell_id", help="Cell ID")
    p.add_argument("line", type=int, help="1-based line")
    p.add_argument("column", type=int, help="1-based column")

    return parser


# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #

COMMAND_MAP = {
    "init": cmd_init,
    "databases": cmd_databases,
    "definitions": cmd_definitions,
}

CELL_COMMAND_MAP = {
    "get": cmd_cell_get,
    "create": cmd_cell_create,
    "edit": cmd_cell_edit,
    "run": cmd_cell_run,
    "outputs": cmd_cell_outputs,
    "delete": cmd_cell_delete,
    "update-control": cmd_cell_update_control,
}

FILE_COMMAND_MAP = {
    "read": cmd_file_read,
    "download": cmd_file_read,
    "text": cmd_file_text,
    "upload": cmd_file_upload,
    "delete": cmd_file_delete,
    "exists": cmd_file_exists,
}

DB_COMMAND_MAP = {
    "schema": cmd_db_schema,
    "search": cmd_db_search,
    "condensed": cmd_db_condensed,
}

KERNEL_COMMAND_MAP = {
    "status": cmd_kernel_status,
    "restart": cmd_kernel_restart,
    "interrupt": cmd_kernel_interrupt,
}

WORKSHEET_COMMAND_MAP = {
    "create": cmd_worksheet_create,
}


def main():
    global VERBOSE
    parser = build_parser()
    args = parser.parse_args()

    VERBOSE = getattr(args, "verbose", False)

    if not args.command:
        parser.print_help()
        sys.exit(1)

    # Top-level commands
    if args.command in COMMAND_MAP:
        COMMAND_MAP[args.command](args)
        return

    if args.command == "files":
        cmd_files(args)
        return

    # Two-level subcommands
    if args.command == "cells":
        if args.cells_command == "run":
            cmd_cells_run(args)
        else:
            cmd_cells(args)
        return

    if args.command == "cell":
        if not args.cell_command:
            parser.parse_args(["cell", "--help"])
            return
        handler = CELL_COMMAND_MAP.get(args.cell_command)
        if handler:
            handler(args)
        else:
            sys.exit(f"Unknown cell command: {args.cell_command}")
        return

    if args.command == "file":
        if not args.file_command:
            parser.parse_args(["file", "--help"])
            return
        handler = FILE_COMMAND_MAP.get(args.file_command)
        if handler:
            handler(args)
        else:
            sys.exit(f"Unknown file command: {args.file_command}")
        return

    if args.command == "db":
        if not args.db_command:
            parser.parse_args(["db", "--help"])
            return
        handler = DB_COMMAND_MAP.get(args.db_command)
        if handler:
            handler(args)
        else:
            sys.exit(f"Unknown db command: {args.db_command}")
        return

    if args.command == "kernel":
        if not args.kernel_command:
            parser.parse_args(["kernel", "--help"])
            return
        handler = KERNEL_COMMAND_MAP.get(args.kernel_command)
        if handler:
            handler(args)
        else:
            sys.exit(f"Unknown kernel command: {args.kernel_command}")
        return

    if args.command == "worksheet":
        if not args.worksheet_command:
            parser.parse_args(["worksheet", "--help"])
            return
        handler = WORKSHEET_COMMAND_MAP.get(args.worksheet_command)
        if handler:
            handler(args)
        else:
            sys.exit(f"Unknown worksheet command: {args.worksheet_command}")
        return

    sys.exit(f"Unknown command: {args.command}")


if __name__ == "__main__":
    main()
