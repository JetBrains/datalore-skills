import requests

# --------------------------------------------------------------------------- #
# Constants
# --------------------------------------------------------------------------- #

SERVICE = "datalore-notebook"
AGENT_SKILL_VERSION = "2026.3"
AGENT_SKILL_VERSION_HEADER = "X-Agent-Skill-Version"
AGENT_SKILL_VERSION_MISMATCH_PROBLEM_TYPE = "urn:datalore:problem:agent-skill-version-mismatch"
LEGACY_AGENT_SKILL_VERSION = "2026.2.2"
KEYRING_ACCESS_PROBE_KEY = "__keyring_access_probe__"
SESSION_FILE = ".datalore-session"
ENV_API_TOKEN = "DATALORE_API_TOKEN"
TERMINAL_STATUSES = {"VALID", "ERROR", "WARNING"}
CREATE_RUNNABLE_CELL_TYPES = {"CODE", "SQL", "CONTROL"}
EDIT_RUNNABLE_CELL_TYPES = {"CODE", "SQL"}
DEFAULT_TIMEOUT = 120
MAX_API_TIMEOUT_MS = 30000
MAX_POLL_INTERVAL = 3.0
CONNECT_TIMEOUT_SECONDS = 20
API_READ_TIMEOUT_SECONDS = 120
TRANSFER_READ_TIMEOUT_SECONDS = 30 * 60
SERVER_WAIT_GRACE_SECONDS = 60
DOWNLOAD_CHUNK_SIZE_BYTES = 1024 * 1024
VERBOSE = False
NOTEBOOK_ID_OVERRIDE = None
WORKSPACE_ID_OVERRIDE = None
OAUTH_CLIENT_ID = "datalore-notebook-cli"
NOTEBOOK_API_SCOPE = "notebook_api"
NOTEBOOK_WITH_WORKSPACE_VIEW_SCOPE = "notebook_with_workspace_view"
USER_BASIC_SCOPE = "user_basic"
WORKSPACE_SCOPE = "workspace"
NOTEBOOK_SCOPES = {NOTEBOOK_API_SCOPE, NOTEBOOK_WITH_WORKSPACE_VIEW_SCOPE}
WORKSPACE_SCOPES = [WORKSPACE_SCOPE]
SUPPORTED_OAUTH_SCOPES = NOTEBOOK_SCOPES | {USER_BASIC_SCOPE, WORKSPACE_SCOPE}
AUTH_ACCESS_ORDER = ["READ", "CREATE", "FULL"]
SUPPORTED_AUTH_ACCESS = {value.lower() for value in AUTH_ACCESS_ORDER}
DEFAULT_AUTH_ACCESS = "FULL"
AUTH_SCOPE_ORDER = [USER_BASIC_SCOPE, NOTEBOOK_API_SCOPE, NOTEBOOK_WITH_WORKSPACE_VIEW_SCOPE, WORKSPACE_SCOPE]
SERVER_SCOPE_TO_OAUTH_SCOPE = {
    "NOTEBOOK_API": NOTEBOOK_API_SCOPE,
    "NOTEBOOK_WITH_WORKSPACE_VIEW": NOTEBOOK_WITH_WORKSPACE_VIEW_SCOPE,
    "USER_BASIC": USER_BASIC_SCOPE,
    "WORKSPACE": WORKSPACE_SCOPE,
}
OAUTH_API_PATH = "/api/user_management/v1/api-tokens/oauth"
AGENT_SKILL_VERSION_API_PATH = "/api/agent/v1/version"
AGENT_SKILL_VALIDATE_VERSION_API_PATH = "/api/agent/v1/validate_version"
NOTEBOOK_API_PATH = "/api/notebook/v1"
USER_PUBLIC_API_PATH = "/api/user_public/v1"
WORKSPACES_API_PATH = "/api/workspaces/v1"
OAUTH_CALLBACK_HOST = "127.0.0.1"
OAUTH_CALLBACK_PATH = "/callback"
OAUTH_CALLBACK_TIMEOUT_SECONDS = 300


def normalize_scope_access(scope, access=None):
    if scope == WORKSPACE_SCOPE:
        normalized_access = (access or DEFAULT_AUTH_ACCESS).upper()
        if normalized_access not in AUTH_ACCESS_ORDER:
            sys.exit(f"Unsupported auth access: {access}")
        return scope, normalized_access
    return scope, DEFAULT_AUTH_ACCESS


def parse_auth_access(value):
    if value is None:
        return DEFAULT_AUTH_ACCESS
    normalized = value.strip().upper()
    if normalized not in AUTH_ACCESS_ORDER:
        supported = ", ".join(sorted(SUPPORTED_AUTH_ACCESS))
        sys.exit(f"--access must be one of: {supported}.")
    return normalized


def auth_access_display(value):
    return value.lower().capitalize()


def higher_or_equal_auth_accesses(value):
    normalized = parse_auth_access(value)
    return AUTH_ACCESS_ORDER[AUTH_ACCESS_ORDER.index(normalized):]


# --------------------------------------------------------------------------- #
# Auth
# --------------------------------------------------------------------------- #

def read_api_token_from_stdin():
    if sys.stdin.isatty():
        sys.exit("--api-token-stdin was provided but stdin is empty.")
    token = sys.stdin.read().strip()
    if not token:
        sys.exit("API token from stdin is empty.")
    return token


def get_env_api_token():
    token = os.environ.get(ENV_API_TOKEN, "").strip()
    return token or None


def reject_api_token_stdin_env_conflict():
    sys.exit(
        f"--api-token-stdin cannot be used while {ENV_API_TOKEN} is set. "
        f"Unset {ENV_API_TOKEN} first so the CLI can use and save the token from stdin."
    )


def exception_summary(error):
    message = str(error).strip()
    if message:
        return f"{error.__class__.__name__}: {message}"
    return error.__class__.__name__


def fail_keychain(action, error):
    sys.exit(
        f"Cannot {action} system keychain credentials: {exception_summary(error)}\n"
        f"Set {ENV_API_TOKEN} for keychain-free use, or fix keychain access and run "
        f"`datalore init <url> [--scope <scope>]` again."
    )


def require_keyring():
    return keyring


def preflight_keyring_access():
    try:
        keyring.get_password(SERVICE, KEYRING_ACCESS_PROBE_KEY)
    except Exception as e:
        sys.exit(
            f"Cannot access the system keychain: {exception_summary(e)}\n"
            "The Datalore CLI requires host execution. Re-run the same command outside the sandbox.\n"
            "Do not set UV_CACHE_DIR or retry inside the sandbox."
        )


def credentials_key(host, scope, owner_id, notebook_id, workspace_id=None, access=DEFAULT_AUTH_ACCESS):
    scope, access = normalize_scope_access(scope, access)
    if scope == NOTEBOOK_API_SCOPE:
        return f"{host}/notebook/{owner_id}/{notebook_id}/api_token"
    if scope == NOTEBOOK_WITH_WORKSPACE_VIEW_SCOPE:
        return f"{host}/notebook/{owner_id}/{notebook_id}/{scope}/api_token"
    if scope in WORKSPACE_SCOPES:
        if not workspace_id:
            sys.exit(f"{scope} requires --workspace-id.")
        return f"{host}/workspace/{workspace_id}/{scope}/{access}/api_token"
    if scope == USER_BASIC_SCOPE:
        return f"{host}/user/{scope}/api_token"
    return sys.exit(f"Unsupported scope: {scope}")


def notebook_credentials_key(host, owner_id, notebook_id):
    return credentials_key(host, NOTEBOOK_API_SCOPE, owner_id, notebook_id)


def load_user_basic_lookup_hint(host):
    session_path = Path(SESSION_FILE)
    if not session_path.exists():
        return None, None, None, None
    try:
        _scheme, session_host, owner_id, notebook_id, scope, workspace_id, access = load_session_identity()
    except SystemExit:
        return None, None, None, None
    if session_host != host:
        return None, None, None, None
    if scope in NOTEBOOK_SCOPES:
        return owner_id, notebook_id, None, None
    if scope in WORKSPACE_SCOPES:
        return None, None, workspace_id, access
    return None, None, None, None


def credential_lookup_keys(host, owner_id, notebook_id, scope, workspace_id=None, access=DEFAULT_AUTH_ACCESS):
    scope, access = normalize_scope_access(scope, access)
    candidate_keys = [credentials_key(host, scope, owner_id, notebook_id, workspace_id, access)]

    if scope in WORKSPACE_SCOPES:
        candidate_keys.extend(
            credentials_key(host, scope, owner_id, notebook_id, workspace_id, candidate_access)
            for candidate_access in higher_or_equal_auth_accesses(access)[1:]
        )
    elif scope == USER_BASIC_SCOPE:
        lookup_owner_id = owner_id
        lookup_notebook_id = notebook_id
        lookup_workspace_id = workspace_id
        lookup_access = access
        if not ((lookup_owner_id and lookup_notebook_id) or lookup_workspace_id):
            lookup_owner_id, lookup_notebook_id, lookup_workspace_id, lookup_access = load_user_basic_lookup_hint(host)
        if lookup_owner_id and lookup_notebook_id:
            candidate_keys.append(credentials_key(host, NOTEBOOK_API_SCOPE, lookup_owner_id, lookup_notebook_id))
        if lookup_workspace_id:
            candidate_keys.extend(
                credentials_key(host, WORKSPACE_SCOPE, None, None, lookup_workspace_id, candidate_access)
                for candidate_access in AUTH_ACCESS_ORDER
            )

    deduped_keys = []
    seen_keys = set()
    for candidate_key in candidate_keys:
        if candidate_key in seen_keys:
            continue
        seen_keys.add(candidate_key)
        deduped_keys.append(candidate_key)
    return deduped_keys


def prompt_credentials(host, owner_id, notebook_id, scope=NOTEBOOK_API_SCOPE, workspace_id=None, access=DEFAULT_AUTH_ACCESS, reason=None):
    scope, access = normalize_scope_access(scope, access)
    if not sys.stdin.isatty():
        if reason:
            sys.exit(
                f"{reason}, and this is a non-interactive session so a replacement "
                f"token cannot be prompted for.\n"
                f"Set {ENV_API_TOKEN}, pass --api-token-stdin, or run "
                f"`datalore init <url> [--scope <scope>]` to authorize through the browser."
            )
        sys.exit(
            f"No {ENV_API_TOKEN} set and no saved credentials, and this is a "
            f"non-interactive session so a token cannot be prompted for.\n"
            f"Set {ENV_API_TOKEN}, pass --api-token-stdin, or run "
            f"`datalore init <url> [--scope <scope>]` to authorize through the browser."
        )
    if scope in NOTEBOOK_SCOPES:
        print(f"\n  Notebook: https://{host}/notebook/{owner_id}/{notebook_id}/\n")
    elif scope in WORKSPACE_SCOPES:
        print(f"\n  Workspace: {workspace_id}\n")
        print(f"  Authorization access: {auth_access_display(access)}")
    else:
        print(f"\n  Host: https://{host}/\n")
    print(f"  Authorization scope: {scope}")
    print("  Datalore API token")
    print("     Paste a token that can access this target.")
    print("     It can be created in the Datalore Notebook UI under Tools > API Token.")
    print()
    api_token = getpass.getpass("  Paste API token: ").strip()
    if not api_token:
        sys.exit("API token is empty.")

    return api_token


def save_credentials(host, owner_id, notebook_id, api_token, scope=NOTEBOOK_API_SCOPE, workspace_id=None, access=DEFAULT_AUTH_ACCESS):
    scope, access = normalize_scope_access(scope, access)
    if get_env_api_token():
        print(f"\n  {ENV_API_TOKEN} is set; system keychain was not updated.\n")
        return
    keyring = require_keyring()
    try:
        keyring.set_password(SERVICE, credentials_key(host, scope, owner_id, notebook_id, workspace_id, access), api_token)
    except Exception as e:
        fail_keychain("save", e)
    print("\n  Saved to system keychain.\n")


def get_keychain_password(keyring, key):
    try:
        return keyring.get_password(SERVICE, key)
    except Exception as e:
        fail_keychain("read", e)


def cache_user_basic_credentials(keyring, host, credential):
    try:
        keyring.set_password(SERVICE, credentials_key(host, USER_BASIC_SCOPE, None, None), credential)
    except Exception:
        return


def get_keychain_credentials(host, owner_id, notebook_id, scope=NOTEBOOK_API_SCOPE, workspace_id=None, access=DEFAULT_AUTH_ACCESS):
    scope, access = normalize_scope_access(scope, access)
    keyring = require_keyring()
    exact_key = credentials_key(host, scope, owner_id, notebook_id, workspace_id, access)
    for candidate_key in credential_lookup_keys(host, owner_id, notebook_id, scope, workspace_id, access):
        credential = get_keychain_password(keyring, candidate_key)
        if credential:
            if scope == USER_BASIC_SCOPE and candidate_key != exact_key:
                cache_user_basic_credentials(keyring, host, credential)
            return credential
    return None


def delete_credentials(host, owner_id, notebook_id, scope=NOTEBOOK_API_SCOPE, workspace_id=None, access=DEFAULT_AUTH_ACCESS):
    scope, access = normalize_scope_access(scope, access)
    keyring = require_keyring()
    key = credentials_key(host, scope, owner_id, notebook_id, workspace_id, access)
    try:
        existing = keyring.get_password(SERVICE, key)
    except Exception as e:
        fail_keychain("read", e)
    if not existing:
        print("\n  No system keychain credentials found.\n")
        return False

    try:
        keyring.delete_password(SERVICE, key)
    except Exception as e:
        fail_keychain("delete", e)
    print("\n  Deleted system keychain credentials.\n")
    return True


def resolve_credentials_for_init(host, owner_id, notebook_id, explicit_api_token=None, scope=NOTEBOOK_API_SCOPE, workspace_id=None,
                                 access=DEFAULT_AUTH_ACCESS):
    scope, access = normalize_scope_access(scope, access)
    if explicit_api_token is not None:
        if get_env_api_token():
            reject_api_token_stdin_env_conflict()
        return explicit_api_token, True, False

    env_api_token = get_env_api_token()
    if env_api_token:
        return env_api_token, False, False

    api_token = get_keychain_credentials(host, owner_id, notebook_id, scope, workspace_id, access)
    if api_token:
        return api_token, False, True

    return prompt_credentials(host, owner_id, notebook_id, scope, workspace_id, access), True, False


# --------------------------------------------------------------------------- #
# OAuth PKCE
# --------------------------------------------------------------------------- #

@dataclass(frozen=True)
class PkcePair:
    verifier: str
    challenge: str


@dataclass(frozen=True)
class OAuthCallbackResult:
    code: Optional[str]
    error: Optional[str]
    message: str


def base64url_without_padding(data):
    return base64.urlsafe_b64encode(data).decode("ascii").rstrip("=")


def generate_pkce_pair():
    verifier = base64url_without_padding(secrets.token_bytes(32))
    return PkcePair(verifier=verifier, challenge=calculate_pkce_challenge(verifier))


def generate_oauth_state():
    return base64url_without_padding(secrets.token_bytes(32))


def calculate_pkce_challenge(verifier):
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    return base64url_without_padding(digest)


def oauth_authorize_url(scheme, host, redirect_uri, state, code_challenge, scope, owner_id=None, notebook_id=None, workspace_id=None,
                        access=DEFAULT_AUTH_ACCESS):
    scope, access = normalize_scope_access(scope, access)
    if scope not in SUPPORTED_OAUTH_SCOPES:
        sys.exit(f"Unsupported OAuth scope: {scope}")

    query_params = {
        "response_type": "code",
        "client_id": OAUTH_CLIENT_ID,
        "redirect_uri": redirect_uri,
        "scope": scope,
        "state": state,
        "code_challenge": code_challenge,
        "code_challenge_method": "S256",
    }
    if scope in NOTEBOOK_SCOPES:
        query_params["notebookId"] = f"{owner_id}/{notebook_id}"
    elif scope in WORKSPACE_SCOPES:
        query_params["workspaceId"] = workspace_id
        query_params["access"] = access.lower()

    query = urllib.parse.urlencode(query_params)
    return f"{scheme}://{host}{OAUTH_API_PATH}/authorize?{query}"


def oauth_token_url(scheme, host):
    return f"{scheme}://{host}{OAUTH_API_PATH}/token"


def parse_oauth_callback(path, expected_state):
    parsed = urllib.parse.urlparse(path)
    if parsed.path != OAUTH_CALLBACK_PATH:
        return OAuthCallbackResult(None, "invalid_callback", "Unexpected OAuth callback path.")

    params = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
    state = first_query_param(params, "state")
    if state != expected_state:
        return OAuthCallbackResult(None, "state_mismatch", "OAuth callback state did not match.")

    error = first_query_param(params, "error")
    if error:
        if error == "access_denied":
            return OAuthCallbackResult(None, error, "Access was denied.")
        return OAuthCallbackResult(None, error, f"Authorization failed: {error}.")

    code = first_query_param(params, "code")
    if not code:
        return OAuthCallbackResult(None, "missing_code", "OAuth callback did not include an authorization code.")

    return OAuthCallbackResult(code, None, "Authorization succeeded.")


def first_query_param(params, name):
    values = params.get(name)
    if not values:
        return None
    return values[0]


def oauth_callback_page(result):
    if result.code and not result.error:
        title = "Datalore CLI authorization complete"
        detail = "You can return to the terminal."
    elif result.error == "access_denied":
        title = "Datalore CLI authorization denied"
        detail = "You can close this tab."
    else:
        title = "Datalore CLI authorization failed"
        detail = result.message

    return (
        "<!doctype html><html><head><meta charset=\"utf-8\">"
        f"<title>{html.escape(title)}</title>"
        "<style>body{font-family:system-ui,-apple-system,BlinkMacSystemFont,sans-serif;margin:48px;line-height:1.4;color:#1f2328}"
        "main{max-width:560px}h1{font-size:24px;margin:0 0 12px}</style></head>"
        f"<body><main><h1>{html.escape(title)}</h1><p>{html.escape(detail)}</p></main></body></html>"
    )


def create_oauth_callback_server(expected_state):
    result_holder = {"result": None}

    class OAuthCallbackHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if urllib.parse.urlparse(self.path).path != OAUTH_CALLBACK_PATH:
                # Ignore stray requests (e.g. browser favicon probes) and keep waiting for the real callback.
                self.send_error(404)
                return
            result = parse_oauth_callback(self.path, expected_state)
            result_holder["result"] = result
            body = oauth_callback_page(result).encode("utf-8")
            status = 200 if result.code and not result.error else 400
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, _format, *_args):
            if VERBOSE:
                super().log_message(_format, *_args)

    server = http.server.HTTPServer((OAUTH_CALLBACK_HOST, 0), OAuthCallbackHandler)
    server.timeout = 1
    redirect_uri = f"http://{OAUTH_CALLBACK_HOST}:{server.server_port}{OAUTH_CALLBACK_PATH}"
    return server, redirect_uri, result_holder


def wait_for_oauth_callback(server, result_holder):
    try:
        deadline = time.monotonic() + OAUTH_CALLBACK_TIMEOUT_SECONDS
        while result_holder["result"] is None and time.monotonic() < deadline:
            server.handle_request()
    finally:
        server.server_close()

    result = result_holder["result"]
    if result is None:
        return OAuthCallbackResult(None, "timeout", "Timed out waiting for browser authorization.")
    return result


def request_oauth_authorization(scheme, host, owner_id, notebook_id, workspace_id, scope, access, pkce_pair, state):
    server, redirect_uri, result_holder = create_oauth_callback_server(state)
    authorize_url = oauth_authorize_url(
        scheme,
        host,
        redirect_uri,
        state,
        pkce_pair.challenge,
        scope,
        owner_id=owner_id,
        notebook_id=notebook_id,
        workspace_id=workspace_id,
        access=access,
    )
    print("Opening browser for Datalore authorization.")
    print()
    print("If the browser does not open, you can copy and paste the following URL into a new tab of your browser:")
    print(authorize_url)
    sys.stdout.flush()
    if not webbrowser.open(authorize_url, new=1, autoraise=True):
        print("Open this URL in your browser to authorize the CLI:")
        print(authorize_url)
        sys.stdout.flush()
    result = wait_for_oauth_callback(server, result_holder)
    return redirect_uri, result


def require_scope_compatibility(scheme, host, scope):
    if scope == NOTEBOOK_API_SCOPE:
        return

    version_url = f"{scheme}://{host}{AGENT_SKILL_VERSION_API_PATH}"
    log_http_request("GET", version_url)
    try:
        version_response = requests.get(
            version_url,
            headers=agent_skill_headers(),
            timeout=default_request_timeout(),
            allow_redirects=False,
        )
    except requests.RequestException as e:
        fail_scope_compatibility(scope, f"the agent skill version probe failed: {e}")

    if version_response.status_code == 200:
        server_skill_version = version_response.text.strip()
        if not server_skill_version:
            fail_scope_compatibility(scope, "the agent skill version endpoint returned an empty response")
        if VERBOSE:
            print(f"  Server agent skill version: {server_skill_version}", file=sys.stderr)

        validate_version_url = f"{scheme}://{host}{AGENT_SKILL_VALIDATE_VERSION_API_PATH}"
        log_http_request("GET", validate_version_url)
        try:
            validate_version_response = requests.get(
                validate_version_url,
                headers=agent_skill_headers(),
                timeout=default_request_timeout(),
                allow_redirects=False,
            )
        except requests.RequestException as e:
            fail_scope_compatibility(scope, f"the agent skill version validation failed: {e}")

        if validate_version_response.status_code != 200:
            if validate_version_response.status_code in (400, 404):
                fail_agent_skill_incompatibility()
            fail_scope_compatibility(
                scope,
                f"the agent skill version validation endpoint returned HTTP {validate_version_response.status_code}",
            )
        return

    if version_response.status_code != 404:
        fail_scope_compatibility(
            scope,
            f"the agent skill version endpoint returned HTTP {version_response.status_code}",
        )

    url = f"{scheme}://{host}{NOTEBOOK_API_PATH}/cells"
    payload = {
        "notebookId": {
            "ownerId": "agent-skill-compatibility-probe",
            "id": "agent-skill-compatibility-probe",
        },
    }
    log_http_request("POST", url, json_body=payload)
    try:
        response = requests.post(
            url,
            headers=agent_skill_headers(),
            json=payload,
            timeout=default_request_timeout(),
            allow_redirects=False,
        )
    except requests.RequestException as e:
        fail_scope_compatibility(scope, f"the public notebook API probe failed: {e}")

    server_skill_version = response.headers.get(AGENT_SKILL_VERSION_HEADER, "").strip()
    if server_skill_version:
        return

    fail_agent_skill_incompatibility()


def fail_agent_skill_incompatibility():
    sys.exit(
        f"The installed datalore-notebook skill version {AGENT_SKILL_VERSION} is incompatible with this Datalore deployment.\n"
        f"Align the versions: use skill version {LEGACY_AGENT_SKILL_VERSION} with Datalore 2026.2.x, "
        "or upgrade Datalore to 2026.3 or newer."
    )


def fail_scope_compatibility(scope, reason):
    sys.exit(
        f"Cannot verify that this Datalore deployment supports scope {scope}: {reason}.\n"
        "Initialization was stopped because this scope is unavailable in Datalore 2026.2.x. "
        f"For a 2026.2.x deployment, install datalore-notebook skill version {LEGACY_AGENT_SKILL_VERSION}; "
        "otherwise upgrade Datalore to 2026.3 or newer and ensure its proxy passes /api/agent/v1 without an OAuth cookie. "
        f"The legacy notebook API fallback also requires the {AGENT_SKILL_VERSION_HEADER} response header."
    )


def exchange_oauth_code_for_token(scheme, host, code, redirect_uri, code_verifier):
    url = oauth_token_url(scheme, host)
    payload = {
        "grant_type": "authorization_code",
        "client_id": OAUTH_CLIENT_ID,
        "code": code,
        "redirect_uri": redirect_uri,
        "code_verifier": code_verifier,
    }
    safe_payload = dict(payload)
    safe_payload["code_verifier"] = "***"
    log_http_request("POST", url, json_body=safe_payload)
    try:
        response = requests.post(
            url,
            headers=agent_skill_headers(),
            data=payload,
            timeout=default_request_timeout(),
        )
    except requests.RequestException as e:
        sys.exit(f"OAuth token exchange failed: {e}")

    body = parse_response_body(response)
    if response.status_code >= 400:
        sys.exit(format_api_error("OAuth token exchange failed", response.status_code, body, response.headers))
    if not isinstance(body, dict):
        sys.exit(f"OAuth token exchange returned an unexpected response (HTTP {response.status_code}).")
    access_token = body.get("accessToken")
    token_type = body.get("tokenType")
    if not isinstance(access_token, str) or not access_token:
        sys.exit("OAuth token exchange did not return an access token.")
    if token_type != "Bearer":
        sys.exit(f"OAuth token exchange returned unsupported token type: {token_type}")
    return access_token


# --------------------------------------------------------------------------- #
# Session management
# --------------------------------------------------------------------------- #

class Session:
    __slots__ = ("host", "scheme", "owner_id", "notebook_id", "workspace_id", "scope", "access", "token")

    def __init__(self, host, owner_id, notebook_id, token="", scheme="https", scope=NOTEBOOK_API_SCOPE, workspace_id=None,
                 access=DEFAULT_AUTH_ACCESS):
        self.host = host
        self.scheme = scheme
        self.owner_id = owner_id
        self.notebook_id = notebook_id
        self.workspace_id = workspace_id
        self.scope = scope
        self.access = access
        self.token = token

    def notebook_id_dict(self):
        if not self.owner_id or not self.notebook_id:
            sys.exit(
                "Current session does not include notebook identity. "
                "Re-run `datalore init <notebook-url> --scope notebook_api`."
            )
        return {"ownerId": self.owner_id, "id": self.notebook_id}


# Regex handles both /notebook/owner/id and /notebook/owner/id/anything
_NOTEBOOK_URL_RE = re.compile(r"(https?)://([^/]+)/notebook/([^/]+)/([^/?#]+)")
_WORKSPACE_URL_RE = re.compile(r"(https?)://([^/]+)/([^/]+)/([^/]+)/notebooks(?:/[^?#]*)?")


def parse_target_url(url, scope):
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        sys.exit(f"Cannot parse URL: {url}\nExpected an absolute http(s) URL.")

    if scope in NOTEBOOK_SCOPES:
        match = _NOTEBOOK_URL_RE.search(url)
        if not match:
            sys.exit(
                f"Cannot parse notebook URL: {url}\n"
                f"Expected: https://<host>/notebook/<ownerId>/<notebookId>/..."
            )
        return match.group(1), match.group(2), match.group(3), match.group(4), None

    if scope in WORKSPACE_SCOPES:
        match = _WORKSPACE_URL_RE.search(url)
        if not match:
            sys.exit(
                f"Cannot parse workspace URL: {url}\n"
                f"Expected: https://<host>/<ownerId>/<workspaceId>/notebooks"
            )
        return match.group(1), match.group(2), None, None, f"{match.group(3)}/{match.group(4)}"

    if scope == USER_BASIC_SCOPE:
        if parsed.path not in ("", "/"):
            sys.exit(
                f"Cannot parse root URL for {scope}: {url}\n"
                f"Expected: https://<host>/"
            )
        return parsed.scheme, parsed.netloc, None, None, None

    sys.exit(f"Unsupported scope: {scope}")


def parse_slash_id(value, id_name):
    if not isinstance(value, str) or "/" not in value:
        sys.exit(f"{id_name} must use <ownerId>/<id> form.")
    owner_id, internal_id = value.split("/", 1)
    if not owner_id or not internal_id:
        sys.exit(f"{id_name} must use <ownerId>/<id> form.")
    return owner_id, internal_id


def save_session(scheme, host, owner_id, notebook_id, scope=NOTEBOOK_API_SCOPE, workspace_id=None, access=DEFAULT_AUTH_ACCESS):
    scope, access = normalize_scope_access(scope, access)
    data = {
        "scheme": scheme,
        "host": host,
        "scope": scope,
    }
    if owner_id:
        data["ownerId"] = owner_id
    if notebook_id:
        data["notebookId"] = notebook_id
    if workspace_id:
        data["workspaceId"] = workspace_id
        data["access"] = access
    try:
        Path(SESSION_FILE).write_text(json.dumps(data, indent=2) + "\n")
    except OSError as e:
        sys.exit(f"Cannot write {SESSION_FILE}: {exception_summary(e)}")


def delete_session():
    session_path = Path(SESSION_FILE)
    try:
        session_path.unlink()
    except FileNotFoundError:
        print(f"No {SESSION_FILE} found.")
        return False
    except OSError as e:
        sys.exit(f"Cannot delete {SESSION_FILE}: {exception_summary(e)}")

    print(f"Deleted {SESSION_FILE}.")
    return True


def load_session_identity():
    """Load session identity from .datalore-session without resolving credentials."""
    path = Path(SESSION_FILE)
    if not path.exists():
        sys.exit(f"No {SESSION_FILE} found. Run `datalore init <url> [--scope <scope>]` first.")
    try:
        data = json.loads(path.read_text())
    except OSError as e:
        sys.exit(f"Cannot read {SESSION_FILE}: {exception_summary(e)}")
    except json.JSONDecodeError as e:
        sys.exit(
            f"Cannot parse {SESSION_FILE}: {exception_summary(e)}\n"
            f"Run `datalore init <url> [--scope <scope>]` again from this directory."
        )
    if not isinstance(data, dict):
        sys.exit(
            f"Invalid {SESSION_FILE}: expected a JSON object.\n"
            f"Run `datalore init <url> [--scope <scope>]` again from this directory."
        )
    scheme = data.get("scheme", "https")
    if not isinstance(scheme, str) or scheme not in ("http", "https"):
        sys.exit(
            f"Invalid {SESSION_FILE}: scheme must be 'http' or 'https'.\n"
            f"Run `datalore init <url> [--scope <scope>]` again from this directory."
        )
    host = data.get("host")
    if not isinstance(host, str) or not host:
        sys.exit(
            f"Invalid {SESSION_FILE}: missing or invalid host.\n"
            f"Run `datalore init <url> [--scope <scope>]` again from this directory."
        )
    raw_scope = data.get("scope", NOTEBOOK_API_SCOPE)
    if not isinstance(raw_scope, str) or raw_scope not in SUPPORTED_OAUTH_SCOPES:
        sys.exit(
            f"Invalid {SESSION_FILE}: unsupported scope.\n"
            f"Run `datalore init <url> [--scope <scope>]` again from this directory."
        )
    scope = raw_scope
    owner_id = data.get("ownerId")
    notebook_id = data.get("notebookId")
    if scope in NOTEBOOK_SCOPES:
        missing_fields = [
            field
            for field, value in (("ownerId", owner_id), ("notebookId", notebook_id))
            if not isinstance(value, str) or not value
        ]
        if missing_fields:
            sys.exit(
                f"Invalid {SESSION_FILE}: missing or invalid {', '.join(missing_fields)} for {scope}.\n"
                f"Run `datalore init <notebook-url> --scope {scope}` again from this directory."
            )
    else:
        owner_id = owner_id if isinstance(owner_id, str) and owner_id else None
        notebook_id = notebook_id if isinstance(notebook_id, str) and notebook_id else None
    workspace_id = data.get("workspaceId")
    access = data.get("access")
    scope, access = normalize_scope_access(scope, access)
    if scope in WORKSPACE_SCOPES and (not isinstance(workspace_id, str) or not workspace_id):
        sys.exit(
            f"Invalid {SESSION_FILE}: workspaceId is required for {scope}.\n"
            f"Run `datalore init <workspace-url> --scope {scope} --workspace-id <owner/workspace>` again from this directory."
        )
    if scope not in WORKSPACE_SCOPES:
        workspace_id = None
        access = DEFAULT_AUTH_ACCESS
    return scheme, host, owner_id, notebook_id, scope, workspace_id, access


def load_session():
    """Load session from .datalore-session and resolve credentials."""
    scheme, host, owner_id, notebook_id, scope, workspace_id, access = load_session_identity()

    token = get_env_api_token()
    if not token:
        token = get_keychain_credentials(host, owner_id, notebook_id, scope, workspace_id, access)
    if not token:
        sys.exit(
            f"No credentials for the current session. Set {ENV_API_TOKEN} or run "
            f"`datalore init <url> [--scope <scope>]`."
        )

    session = Session(host, owner_id, notebook_id, token, scheme, scope, workspace_id, access)
    if NOTEBOOK_ID_OVERRIDE:
        session.owner_id, session.notebook_id = parse_slash_id(NOTEBOOK_ID_OVERRIDE, "notebookId")
    if WORKSPACE_ID_OVERRIDE:
        parse_slash_id(WORKSPACE_ID_OVERRIDE, "workspaceId")
        session.workspace_id = WORKSPACE_ID_OVERRIDE
    return session


def auth_access_covers(current_access, required_access):
    return AUTH_ACCESS_ORDER.index(parse_auth_access(current_access)) >= AUTH_ACCESS_ORDER.index(parse_auth_access(required_access))


def auth_scope_covers(current_scope, required_scope):
    return AUTH_SCOPE_ORDER.index(current_scope) >= AUTH_SCOPE_ORDER.index(required_scope)


def require_workspace_resource_session(session, command_label, required_access):
    if session.scope not in WORKSPACE_SCOPES and not WORKSPACE_ID_OVERRIDE:
        hint = authorization_flow_hint("WORKSPACE", required_access, session)
        sys.exit(
            f"`{command_label}` requires a workspace-scoped session with at least "
            f"{auth_access_display(required_access)} access. {hint}"
        )
    if session.scope in WORKSPACE_SCOPES and not auth_access_covers(session.access, required_access):
        hint = authorization_flow_hint("WORKSPACE", required_access, session)
        sys.exit(
            f"`{command_label}` requires at least {auth_access_display(required_access)} workspace access, "
            f"but the current session has {auth_access_display(session.access)} access. {hint}"
        )


def require_notebook_resource_session(session, command_label, required_scope=NOTEBOOK_API_SCOPE, required_access="READ"):
    if not auth_scope_covers(session.scope, required_scope):
        server_scope = "NOTEBOOK_WITH_WORKSPACE_VIEW" if required_scope == NOTEBOOK_WITH_WORKSPACE_VIEW_SCOPE else "NOTEBOOK_API"
        hint = authorization_flow_hint(server_scope, required_access, session)
        sys.exit(f"`{command_label}` requires at least {required_scope} scope. {hint}")
    if session.scope == WORKSPACE_SCOPE and not auth_access_covers(session.access, required_access):
        hint = authorization_flow_hint("WORKSPACE", required_access, session)
        sys.exit(
            f"`{command_label}` requires at least {auth_access_display(required_access)} workspace access, "
            f"but the current session has {auth_access_display(session.access)} access. {hint}"
        )


# --------------------------------------------------------------------------- #
# HTTP helpers
# --------------------------------------------------------------------------- #

def agent_skill_headers():
    return {AGENT_SKILL_VERSION_HEADER: AGENT_SKILL_VERSION}


def auth_headers(session):
    return {
        **agent_skill_headers(),
        "Authorization": f"Bearer {session.token}",
    }


def log_http_request(method, url, *, params=None, json_body=None, files=None):
    if not VERBOSE:
        return
    details = []
    if params:
        details.append(f"params={json.dumps(params, sort_keys=True)}")
    if json_body is not None:
        details.append(f"json={json.dumps(json_body, sort_keys=True)}")
    if files:
        details.append(f"files={','.join(files)}")
    suffix = f" ({'; '.join(details)})" if details else ""
    print(f"  {method} {url}{suffix}", file=sys.stderr)


def request_timeout(read_timeout_seconds):
    return (CONNECT_TIMEOUT_SECONDS, read_timeout_seconds)


def default_request_timeout():
    return request_timeout(API_READ_TIMEOUT_SECONDS)


def transfer_request_timeout():
    return request_timeout(TRANSFER_READ_TIMEOUT_SECONDS)


def request_timeout_for_server_wait(wait_timeout_ms, operation_count=1):
    read_timeout = (max(wait_timeout_ms, 0) * max(operation_count, 1) / 1000) + SERVER_WAIT_GRACE_SECONDS
    return request_timeout(max(API_READ_TIMEOUT_SECONDS, read_timeout))


def parse_response_body(response):
    body_text = response.text
    if response.status_code == 204 or not body_text.strip():
        return None
    try:
        return response.json()
    except ValueError:
        return body_text


def body_error_message(body):
    if isinstance(body, dict):
        return body.get("error") or body.get("message") or json.dumps(body)
    if isinstance(body, bytes):
        return body.decode("utf-8", errors="replace")[:500]
    if body is None:
        return ""
    return str(body)[:500]


def required_scope_from_headers(headers):
    if not headers:
        return None
    header_value = headers.get("WWW-Authenticate") or headers.get("Www-Authenticate")
    if not header_value:
        return None
    match = re.search(r'\bscope="([^"]+)"', header_value)
    if not match:
        return None
    return match.group(1).strip() or None


def required_access_from_headers(headers):
    if not headers:
        return None
    header_value = headers.get("WWW-Authenticate") or headers.get("Www-Authenticate")
    if not header_value:
        return None
    match = re.search(r'\baccess="([^"]+)"', header_value)
    if not match:
        return None
    return match.group(1).strip().upper() or None


def notebook_url_for_session(session):
    if session is None or not session.host or not session.owner_id or not session.notebook_id:
        return "<notebook-url>"
    return f"{session.scheme}://{session.host}/notebook/{session.owner_id}/{session.notebook_id}/"


def workspace_url_for_session(session):
    if session is None or not session.host:
        return "<workspace-url>"
    workspace_id = session.workspace_id
    if not workspace_id or "/" not in workspace_id:
        return "<workspace-url>"
    owner_id, internal_id = workspace_id.split("/", 1)
    return f"{session.scheme}://{session.host}/{owner_id}/{internal_id}/notebooks"


def authorization_target_url_for_scope(oauth_scope, session=None):
    if oauth_scope in NOTEBOOK_SCOPES:
        return notebook_url_for_session(session)
    if oauth_scope in WORKSPACE_SCOPES:
        return workspace_url_for_session(session)
    if oauth_scope == USER_BASIC_SCOPE:
        if session is None or not session.host:
            return "<host-url>"
        return f"{session.scheme}://{session.host}/"
    return "<authorization-url>"


def authorization_flow_hint(required_scope, required_access=None, session=None):
    oauth_scope = SERVER_SCOPE_TO_OAUTH_SCOPE.get(required_scope)
    if oauth_scope is None:
        return f"The server requires scope {required_scope}, which this CLI cannot authorize automatically."

    command = f"datalore init {authorization_target_url_for_scope(oauth_scope, session)} --scope {oauth_scope}"
    if oauth_scope in WORKSPACE_SCOPES:
        workspace_id = session.workspace_id if session and session.workspace_id else "<owner/workspace>"
        command += f" --workspace-id {workspace_id}"
        command += f" --access {(required_access or DEFAULT_AUTH_ACCESS).lower()}"

    env_hint = ""
    if get_env_api_token():
        env_hint = f"Unset {ENV_API_TOKEN} first or replace it with a token that has this scope. "

    return (
        f"The server requires scope {required_scope}"
        f"{f' with {auth_access_display(required_access)} access' if required_access else ''}. "
        f"{env_hint}Start a new authorization flow with `{command}` from this directory."
    )


def format_api_error(prefix, status, body, headers=None, session=None):
    message = body_error_message(body)
    if status == 401:
        detail = f": {message}" if message else ""
        return (
            f"{prefix}: authentication failed (HTTP {status}){detail}\n"
            f"The Datalore API token is missing, invalid, or expired. "
            f"Check {ENV_API_TOKEN} or run `datalore init <url> [--scope <scope>]` again from this directory."
        )
    if isinstance(body, dict) and body.get("type") == AGENT_SKILL_VERSION_MISMATCH_PROBLEM_TYPE:
        server_version = headers.get(AGENT_SKILL_VERSION_HEADER, "unknown") if headers else "unknown"
        raw_compatible_versions = body.get("compatibleVersions")
        compatible_versions = []
        if isinstance(raw_compatible_versions, list):
            for version in raw_compatible_versions:
                if not isinstance(version, str):
                    continue
                version = version.strip()
                if version and version != server_version and version not in compatible_versions:
                    compatible_versions.append(version)

        if compatible_versions:
            compatible_versions_hint = f"Server-compatible skill versions: {', '.join(compatible_versions)}.\n"
            if server_version == "unknown":
                install_hint = "Install one of the compatible datalore-notebook skill versions listed above"
            else:
                install_hint = f"Install datalore-notebook skill version {server_version} or any listed compatible version"
        else:
            compatible_versions_hint = ""
            install_hint = f"Install datalore-notebook skill version {server_version} to match the server"

        return (
            f"{prefix}: agent skill version does not match server.\n"
            f"Current skill version: {AGENT_SKILL_VERSION}.\n"
            f"Server-required skill version: {server_version}.\n"
            f"{compatible_versions_hint}"
            f"{install_hint} (upgrade or downgrade as needed)."
        )
    if status == 403:
        detail = f": {message}" if message else ""
        required_scope = required_scope_from_headers(headers)
        required_access = required_access_from_headers(headers)
        if required_scope:
            return (
                f"{prefix}: access denied (HTTP 403){detail}\n"
                f"{authorization_flow_hint(required_scope, required_access, session)}"
            )
        return (
            f"{prefix}: access denied (HTTP 403){detail}\n"
            "The token is valid, but it does not have permission for this request."
        )
    detail = f": {message}" if message else ""
    return f"{prefix} (HTTP {status}){detail}"


def require_matching_workspace_agent_skill_version(scope, headers):
    if scope not in WORKSPACE_SCOPES:
        return

    server_version = headers.get(AGENT_SKILL_VERSION_HEADER, "").strip() if headers else ""
    if not server_version:
        sys.exit(
            "Cannot initialize workspace session: the server response did not include "
            f"{AGENT_SKILL_VERSION_HEADER}.\n"
            f"Current skill version: {AGENT_SKILL_VERSION}.\n"
            "This Datalore deployment may predate workspace-scope support. The session was not saved. "
            f"For Datalore 2026.2.x, install datalore-notebook skill version {LEGACY_AGENT_SKILL_VERSION}; "
            "otherwise upgrade Datalore and ensure its proxy preserves the agent skill version response header."
        )
    if server_version != AGENT_SKILL_VERSION:
        sys.exit(format_api_error(
            "API error",
            400,
            {"type": AGENT_SKILL_VERSION_MISMATCH_PROBLEM_TYPE},
            headers,
        ))


def build_api_url(session, api_path, endpoint):
    return f"{session.scheme}://{session.host}{api_path}{endpoint}"


def api_request(
        session,
        api_path,
        endpoint,
        *,
        method="POST",
        payload=None,
        data=None,
        params=None,
        raw=False,
        timeout=None,
        content_type=None,
):
    """Make an API request. Returns (http_status, parsed_body, response_headers).

    When *raw* is True the response stream is returned for file downloads.
    """
    url = build_api_url(session, api_path, endpoint)
    log_http_request(method, url, params=params, json_body=payload)
    timeout = timeout or default_request_timeout()
    headers = auth_headers(session)
    if content_type:
        headers["Content-Type"] = content_type
    request_kwargs = {
        "headers": headers,
        "params": params,
        "timeout": timeout,
        "stream": raw,
    }
    if payload is not None:
        request_kwargs["json"] = payload
    if data is not None:
        request_kwargs["data"] = data

    try:
        if method == "POST":
            response = requests.post(url, **request_kwargs)
        elif method == "GET":
            response = requests.get(url, **request_kwargs)
        else:
            sys.exit(f"Unsupported API method: {method}")
    except requests.RequestException as e:
        return 0, str(e), {}

    if raw and response.status_code < 400:
        return response.status_code, response, response.headers

    body = parse_response_body(response)
    if response.status_code < 400 and isinstance(body, str):
        sys.exit(f"Unexpected response (HTTP {response.status_code}):\n{body[:500]}")
    return response.status_code, body, response.headers


def api_expect_success(prefix, session, status, body, headers):
    if status == 0:
        sys.exit(f"API request failed: {body}")
    if status >= 400:
        sys.exit(format_api_error(prefix, status, body, headers, session))
    return body


def notebook_api_request(session, endpoint, payload=None, raw=False, timeout=None):
    return api_request(session, NOTEBOOK_API_PATH, endpoint, method="POST", payload=payload, raw=raw, timeout=timeout)


def notebook_api_post(session, endpoint, payload, timeout=None, error_prefix="API error"):
    return api_expect_success(error_prefix, session, *notebook_api_request(session, endpoint, payload, timeout=timeout))


def workspace_api_get(session, endpoint, params=None, timeout=None, error_prefix="Workspace API error"):
    return api_expect_success(
        error_prefix,
        session,
        *api_request(session, WORKSPACES_API_PATH, endpoint, method="GET", params=params, timeout=timeout),
    )


def workspace_api_post(session, endpoint, payload=None, params=None, timeout=None, error_prefix="Workspace API error"):
    return api_expect_success(
        error_prefix,
        session,
        *api_request(session, WORKSPACES_API_PATH, endpoint, method="POST", payload=payload, params=params, timeout=timeout),
    )


def workspace_api_post_raw(session, endpoint, data, params=None, timeout=None, content_type=None):
    return api_request(
        session,
        WORKSPACES_API_PATH,
        endpoint,
        method="POST",
        data=data,
        params=params,
        raw=True,
        timeout=timeout,
        content_type=content_type,
    )


def user_api_get(session, endpoint, params=None, timeout=None, error_prefix="User API error"):
    return api_expect_success(
        error_prefix,
        session,
        *api_request(session, USER_PUBLIC_API_PATH, endpoint, method="GET", params=params, timeout=timeout),
    )


def api_upload(session, endpoint, file_path, query_params, timeout=None):
    """Multipart file upload."""
    url = build_api_url(session, NOTEBOOK_API_PATH, endpoint)
    log_http_request("POST", url, params=query_params, files=["file"])
    timeout = timeout or transfer_request_timeout()
    try:
        with open(file_path, "rb") as f:
            response = requests.post(
                url,
                headers=auth_headers(session),
                params=query_params,
                files={"file": (os.path.basename(file_path), f)},
                timeout=timeout,
            )
    except requests.RequestException as e:
        sys.exit(f"Upload failed: {e}")

    body_text = response.text
    if response.status_code >= 400:
        sys.exit(format_api_error("Upload failed", response.status_code, parse_response_body(response), response.headers, session))
    try:
        return json.loads(body_text) if body_text.strip() else None
    except json.JSONDecodeError:
        return body_text


def parse_json_argument(value, argument_name):
    """Parse inline JSON, @file JSON, or '-' JSON from stdin."""
    if value == "-":
        text = sys.stdin.read()
    elif value.startswith("@"):
        text = Path(value[1:]).read_text()
    else:
        text = value
    try:
        parsed = json.loads(text)
    except json.JSONDecodeError as e:
        sys.exit(f"Invalid JSON for {argument_name}: {e}")
    if not isinstance(parsed, dict):
        sys.exit(f"{argument_name} must be a JSON object.")
    return parsed


def read_text_file(path, argument_name):
    try:
        return Path(path).read_text()
    except OSError as e:
        sys.exit(f"Cannot read file for {argument_name}: {path}: {e}")


def parse_key_value_argument(value, argument_name):
    if "=" not in value:
        sys.exit(f"{argument_name} must be in KEY=VALUE format: {value}")
    key, parsed_value = value.split("=", 1)
    key = key.strip()
    if not key:
        sys.exit(f"{argument_name} key must not be empty: {value}")
    return key, parsed_value


def parse_key_value_arguments(values, argument_name):
    parsed = {}
    for value in values or []:
        key, parsed_value = parse_key_value_argument(value, argument_name)
        if key in parsed:
            sys.exit(f"Duplicate key '{key}' in {argument_name}.")
        parsed[key] = parsed_value
    return parsed


def parse_key_path_arguments(values, argument_name):
    parsed = {}
    for value in values or []:
        key, path = parse_key_value_argument(value, argument_name)
        if key in parsed:
            sys.exit(f"Duplicate key '{key}' in {argument_name}.")
        if not path:
            sys.exit(f"{argument_name} path must not be empty for key '{key}'.")
        parsed[key] = path
    return parsed


def current_timestamp_iso():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def new_resource_id():
    return uuid.uuid4().hex


def bool_to_json_string(value):
    return "true" if value else "false"


def serialize_map_argument(mapping):
    return {
        "keys": list(mapping.keys()),
        "values": list(mapping.values()),
    }


def maybe_serialize_map_argument(value, argument_name):
    if value is None:
        return serialize_map_argument({})
    if not isinstance(value, dict):
        sys.exit(f"{argument_name} must be a JSON object.")
    if set(value.keys()) == {"keys", "values"}:
        return value
    return serialize_map_argument(value)


def normalize_resource_update_payload(resource_type, resource_data):
    if resource_type == "databases":
        normalized = dict(resource_data)
        for field_name in ("params", "additionalProperties", "advancedProperties", "keys"):
            if field_name in normalized:
                normalized[field_name] = maybe_serialize_map_argument(normalized[field_name], field_name)
        return normalized
    if resource_type == "datasources":
        normalized = dict(resource_data)
        if "fields" in normalized:
            normalized["fields"] = maybe_serialize_map_argument(normalized["fields"], "fields")
        return normalized
    return resource_data


def workspace_owner_id(session):
    if session.workspace_id:
        owner_id, _workspace_internal_id = parse_slash_id(session.workspace_id, "workspaceId")
        return owner_id
    return session.owner_id


def default_datasource_fields(session, kind):
    if kind == "S3":
        return {"useDefaultCredentials": "false"}
    if kind == "GCS":
        return {"useDefaultCredentials": "false"}
    if kind == "GD":
        owner_id = workspace_owner_id(session)
        if not owner_id:
            sys.exit("Cannot infer Google Drive OWNER_ID for the current workspace.")
        return {
            "ROOT_FOLDER": "",
            "OWNER_ID": owner_id,
        }
    if kind == "SMB/CIFS":
        return {"port": "445"}
    sys.exit(f"Unsupported datasource kind: {kind}")


def build_database_ssh_tunnel_configuration(args):
    ssh_enabled = any(
        value is not None and value != ""
        for value in (
            args.ssh_host,
            args.ssh_port,
            args.ssh_user,
            args.ssh_password,
            args.ssh_key_id,
            args.ssh_auth,
        )
    )
    if not ssh_enabled:
        return None

    if not args.ssh_host:
        sys.exit("--ssh-host is required when SSH configuration is provided.")
    if not args.ssh_user:
        sys.exit("--ssh-user is required when SSH configuration is provided.")

    ssh_auth = args.ssh_auth or ("key-pair" if args.ssh_key_id else "password")
    if ssh_auth == "password":
        if args.ssh_password is None:
            sys.exit("--ssh-password is required for --ssh-auth password.")
        if args.ssh_key_id:
            sys.exit("--ssh-key-id cannot be used with --ssh-auth password.")
        credentials = {
            "type": "PASSWORD",
            "password": args.ssh_password,
        }
    else:
        if not args.ssh_key_id:
            sys.exit("--ssh-key-id is required for --ssh-auth key-pair.")
        if args.ssh_password is not None:
            sys.exit("--ssh-password cannot be used with --ssh-auth key-pair.")
        credentials = {
            "type": "KEY_PAIR",
            "sshKeyId": args.ssh_key_id,
        }

    return {
        "host": args.ssh_host,
        "port": args.ssh_port if args.ssh_port is not None else 22,
        "username": args.ssh_user,
        "credentials": credentials,
    }


def build_database_create_resource(args):
    additional_properties = parse_key_value_arguments(args.additional, "--additional")
    additional_files = parse_key_path_arguments(args.additional_file, "--additional-file")
    keys = parse_key_value_arguments(args.key, "--key")
    key_files = parse_key_path_arguments(args.key_file, "--key-file")

    for field_key, path in additional_files.items():
        if field_key in additional_properties:
            sys.exit(f"Duplicate key '{field_key}' provided in --additional and --additional-file.")
        file_name = Path(path).name
        if file_name in keys:
            sys.exit(f"Duplicate database key file name '{file_name}' provided in --key/--key-file and --additional-file.")
        additional_properties[field_key] = file_name
        keys[file_name] = read_text_file(path, "--additional-file")

    for key_name, path in key_files.items():
        if key_name in keys:
            sys.exit(f"Duplicate key '{key_name}' in --key and --key-file.")
        keys[key_name] = read_text_file(path, "--key-file")

    if args.save_tokens is not None:
        if "SaveTokens" in additional_properties:
            sys.exit("SaveTokens was provided both explicitly and through --save-tokens/--no-save-tokens.")
        additional_properties["SaveTokens"] = bool_to_json_string(args.save_tokens)

    return {
        "id": new_resource_id(),
        "driverRef": {
            "is_predefined": args.driver_kind == "predefined",
            "id": args.driver_id,
        },
        "name": args.name,
        "userName": args.user_name or None,
        "password": args.password,
        "params": serialize_map_argument(parse_key_value_arguments(args.param, "--param")),
        "paramsGroupId": args.param_group_id,
        "additionalProperties": serialize_map_argument(additional_properties),
        "advancedProperties": serialize_map_argument(parse_key_value_arguments(args.advanced, "--advanced")),
        "keys": serialize_map_argument(keys),
        "authProviderId": args.auth_provider_id,
        "sshTunnelConfiguration": build_database_ssh_tunnel_configuration(args),
        "introspectionScope": None,
        "vmOptions": args.vm_options,
        "useExperimentalSession": args.use_experimental_session,
    }


def build_datasource_create_resource(session, args):
    fields = default_datasource_fields(session, args.kind)
    explicit_fields = parse_key_value_arguments(args.field, "--field")
    explicit_field_files = parse_key_path_arguments(args.field_file, "--field-file")
    duplicated_fields = set(explicit_fields) & set(explicit_field_files)
    if duplicated_fields:
        duplicated = ", ".join(sorted(duplicated_fields))
        sys.exit(f"Duplicate datasource field(s) provided in --field and --field-file: {duplicated}")
    fields.update(explicit_fields)
    for key, path in explicit_field_files.items():
        fields[key] = read_text_file(path, "--field-file")

    return {
        "id": new_resource_id(),
        "name": args.name,
        "kind": args.kind,
        "fields": serialize_map_argument(fields),
    }


def build_environment_create_resource(args):
    variables = []
    for key, value in parse_key_value_arguments(args.variable, "--variable").items():
        variables.append({
            "key": key,
            "value": value,
        })

    return {
        "id": new_resource_id(),
        "name": args.name,
        "variables": variables,
    }


def build_git_repository_create_resource(args):
    reference_type = args.default_reference_type
    if reference_type is None:
        reference_type = "head" if args.default_reference == "HEAD" else "branch"

    reference_type_map = {
        "head": "Head",
        "branch": "Branch",
        "tag": "Tag",
        "commit": "Commit",
        "unknown": "Unknown",
    }

    return {
        "id": new_resource_id(),
        "name": args.name,
        "url": args.url,
        "sshKeyId": args.ssh_key_id,
        "defaultReference": {
            "reference": args.default_reference,
            "type": reference_type_map[reference_type],
        },
        "creationTime": current_timestamp_iso(),
    }


def build_ssh_key_create_resource(session, args):
    if args.generate:
        generated_key = resource_api_post(
            session,
            "ssh-keys",
            "/generate",
            params={"algorithm": args.generate.upper()},
        )
        generated_key["name"] = args.name or generated_key.get("name") or "New SSH key"
        return generated_key

    if args.private_key_file:
        private_key = read_text_file(args.private_key_file, "--private-key-file")
    else:
        private_key = args.private_key

    parse_result = resource_api_post(session, "ssh-keys", "/parse", payload={"privateKey": private_key})
    if parse_result.get("kind") != "SUCCESS":
        message = parse_result.get("message") or "Unknown SSH key parse error"
        sys.exit(f"Invalid SSH private key: {message}")

    public_key = parse_result["publicKey"]
    return {
        "id": new_resource_id(),
        "name": args.name or public_key.get("comment") or "New SSH key",
        "privateKey": private_key,
        "publicKey": public_key["key"],
        "md5Fingerprint": public_key["md5Fingerprint"],
        "sha256Fingerprint": public_key["sha256Fingerprint"],
        "comment": public_key.get("comment"),
        "creationTime": current_timestamp_iso(),
    }


def build_resource_create_payload(session, args):
    resource_type = args.resource_type
    if resource_type == "databases":
        return build_database_create_resource(args)
    if resource_type == "datasources":
        return build_datasource_create_resource(session, args)
    if resource_type == "environments":
        return build_environment_create_resource(args)
    if resource_type == "git-repositories":
        return build_git_repository_create_resource(args)
    if resource_type == "ssh-keys":
        return build_ssh_key_create_resource(session, args)
    sys.exit(f"Create is not implemented for resource type: {resource_type}")


def print_json(body):
    print(json.dumps(body, indent=2))


def add_inheritable_json_flag(parser, help_text="Output raw JSON"):
    parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help=help_text)


