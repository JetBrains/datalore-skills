#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["keyring==25.7.0", "requests>=2.32,<3"]
# ///
"""
Datalore CLI — manage sessions, workspaces, notebook content, and workspace resources.

Top-level commands:
  datalore init <url>              Initialize a session for notebook, workspace, or user scope
  datalore workspaces              List own workspaces
  datalore workspace ...           Workspace-scoped operations and resources
  datalore notebook ...            Notebook-scoped operations
  datalore logout [url]            Delete saved credentials and session

Workspace operations:
  datalore workspace info          Show current workspace metadata
  datalore workspace entries       List direct entries of the current workspace
  datalore workspace reports        List all reports in the current workspace
  datalore workspace file <entity-id>
                                   Show file/notebook metadata
  datalore workspace breadcrumbs <entity-id>
                                   Show breadcrumbs for an entity
  datalore workspace folder <folder-id>
                                   Show folder metadata, breadcrumb, and direct children
  datalore workspace folder-entries <folder-id>
                                   List direct entries of a folder in the current workspace
  datalore workspace mkdir <name> [--parent <folder-id>]
                                   Create a folder in the current workspace
  datalore workspace create-notebook <name> [--parent <folder-id>] [--language python]
                                   Create a notebook in the current workspace
  datalore workspace rename <entity-id> <name>
                                   Rename a notebook or folder
  datalore workspace move <entity-id> <parent-id>
                                   Move a notebook or folder
  datalore workspace move-to-trash <entity-id>
                                   Move an entity to trash
  datalore workspace remove-from-trash <entity-id>
                                   Permanently remove an entity from trash
  datalore workspace restore-from-trash <entity-id>
                                   Restore an entity from trash
  datalore workspace empty-trash   Permanently remove all trash contents
  datalore workspace database query [--workspace-id <id>] --database-id <id> --name <name> --query <sql>
                                    Execute a database query and write CSV to stdout
  datalore workspace databases [list|get|drivers|create|update|delete|search|usage|clone] ...
                                   Manage workspace database resources
  datalore workspace datasources [list|get|create|update|delete|search|usage|clone] ...
  datalore workspace environments [list|get|create|update|delete|search|usage|clone] ...
  datalore workspace git-repositories [list|get|create|update|delete|search|usage|clone] ...
  datalore workspace ssh-keys [list|get|create|update|delete|search|usage|clone] ...

Notebook operations:
  datalore notebook cells [--full] List all cells
  datalore notebook cells run <ids...>
                                   Execute cells in order
  datalore notebook cell get <id>  Get cell with status and outputs
  datalore notebook cell create [flags]
                                   Create cell (source from stdin)
  datalore notebook cell edit <id> [flags]
                                   Edit cell (new source from stdin)
  datalore notebook cell run <id> [--wait]
                                   Execute a cell
  datalore notebook cell outputs <id>
                                   Get cell outputs
  datalore notebook cell delete <id>
                                   Delete a cell
  datalore notebook cell update-control <id>
                                   Update a control cell
  datalore notebook files [--directory D]
                                   List files
  datalore notebook file read <path>
                                   Download file to stdout
  datalore notebook file text <path>
                                   Read a text preview
  datalore notebook file upload <local>
                                   Upload file
  datalore notebook file delete <path>
                                   Delete file
  datalore notebook file exists <path>
                                   Check file existence
  datalore notebook attached-databases
                                   List databases attached to the current notebook
  datalore notebook databases [attached|get-attached|attach|detach] ...
                                   Manage notebook database attachments
  datalore notebook datasources [attached|get-attached|attach|update-attachment|detach] ...
                                   Manage notebook datasource attachments
  datalore notebook environments [attached|get-attached|attach|detach] ...
                                   Manage notebook environment attachments
  datalore notebook git-repositories [attached|get-attached|attach|update-attachment|detach] ...
                                   Manage notebook git repository attachments
  datalore notebook db schema <id>
                                   Browse schema tree
  datalore notebook db condensed <id>
                                   Print compact schema text
  datalore notebook db search <id> <query>
                                   Search schema by name
  datalore notebook kernel status  Check kernel state
  datalore notebook kernel restart Restart kernel
  datalore notebook kernel interrupt
                                   Interrupt execution
  datalore notebook agent stop     Stop the notebook agent
  datalore notebook worksheet create
                                   Create a worksheet tab
  datalore notebook report [get|replace|add-tab|rename-tab|move-tab|remove-tab|
                            add-row|move-row|remove-row|upsert-cell|remove-cell|publish] ...
                                   Manage and publish the notebook report layout
  datalore notebook definitions <id> <line> <column>
                                   Go to definition

Authentication uses a Datalore API token as a bearer token. Set
`DATALORE_API_TOKEN` for keychain-free environments, pass `--api-token-stdin`,
or run `datalore init <url> [--scope <scope>]` to authorize through the browser and
save scoped credentials interactively.
"""

import argparse
import base64
import datetime
