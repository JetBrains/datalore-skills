#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["keyring==25.7.0", "requests>=2.32,<3"]
# ///
"""
Datalore notebook CLI — manage cells, files, and databases from the command line.

Session management:
  datalore init <notebook-url>     Parse URL, verify auth, save session

Cell operations:
  datalore cells [--full]          List all cells
  datalore cells run <ids...>      Execute cells in order
  datalore cell get <id>           Get cell with status and outputs
  datalore cell create [flags]     Create cell (source from stdin)
  datalore cell edit <id> [flags]  Edit cell (new source from stdin)
  datalore cell run <id> [--wait]  Execute a cell
  datalore cell outputs <id>       Get cell outputs
  datalore cell delete <id>        Delete a cell
  datalore cell update-control <id> Update a control cell

File operations:
  datalore files [--directory D]   List files
  datalore file read <path>        Download file to stdout
  datalore file text <path>        Read a text preview
  datalore file upload <local>     Upload file
  datalore file delete <path>      Delete file
  datalore file exists <path>      Check file existence

Database operations:
  datalore databases               List attached databases
  datalore db schema <id>          Browse schema tree
  datalore db condensed <id>       Print compact schema text
  datalore db search <id> <query>  Search schema by name

Kernel operations:
  datalore kernel status           Check kernel state
  datalore kernel restart          Restart kernel
  datalore kernel interrupt        Interrupt execution

Worksheet operations:
  datalore worksheet create        Create a worksheet tab

Code insight:
  datalore definitions <id> <line> <column>

Authentication uses a Datalore API token as a bearer token. Set
`DATALORE_API_TOKEN` for keychain-free environments, pass `--api-token-stdin`,
or run `datalore init <url>` to authorize through the browser and
save notebook credentials interactively.
"""

import argparse
import base64
import hashlib
import getpass
import html
import http.server
import json
import os
import re
import secrets
import sys
import time
import urllib.parse
import webbrowser
from dataclasses import dataclass
from pathlib import Path
from typing import Optional

import requests


# --------------------------------------------------------------------------- #
# Constants
# --------------------------------------------------------------------------- #

SERVICE = "datalore-notebook"
SESSION_FILE = ".datalore-session"
ENV_API_TOKEN = "DATALORE_API_TOKEN"
TERMINAL_STATUSES = {"VALID", "ERROR", "WARNING"}
CREATE_RUNNABLE_CELL_TYPES = {"CODE", "SQL", "CONTROL"}
EDIT_RUNNABLE_CELL_TYPES = {"CODE", "SQL"}
DEFAULT_TIMEOUT = 120
MAX_API_TIMEOUT_MS = 30000
MAX_POLL_INTERVAL = 3.0
CONNECT_TIMEOUT_SECONDS = 20
API_READ_TIMEOUT_SECONDS = 120
TRANSFER_READ_TIMEOUT_SECONDS = 30 * 60
SERVER_WAIT_GRACE_SECONDS = 60
DOWNLOAD_CHUNK_SIZE_BYTES = 1024 * 1024
VERBOSE = False
OAUTH_CLIENT_ID = "datalore-notebook-cli"
OAUTH_SCOPE = "notebook_api"
OAUTH_API_PATH = "/api/user_management/v1/api-tokens/oauth"
OAUTH_CALLBACK_HOST = "127.0.0.1"
OAUTH_CALLBACK_PATH = "/callback"
OAUTH_CALLBACK_TIMEOUT_SECONDS = 300


# --------------------------------------------------------------------------- #
# Auth
# --------------------------------------------------------------------------- #

def read_api_token_from_stdin():
    if sys.stdin.isatty():
        sys.exit("--api-token-stdin was provided but stdin is empty.")
    token = sys.stdin.read().strip()
    if not token:
        sys.exit("API token from stdin is empty.")
    return token


def get_env_api_token():
    token = os.environ.get(ENV_API_TOKEN, "").strip()
    return token or None


def reject_api_token_stdin_env_conflict():
    sys.exit(
        f"--api-token-stdin cannot be used while {ENV_API_TOKEN} is set. "
        f"Unset {ENV_API_TOKEN} first so the CLI can use and save the token from stdin."
    )


def exception_summary(error):
    message = str(error).strip()
    if message:
        return f"{error.__class__.__name__}: {message}"
    return error.__class__.__name__


def fail_keychain(action, error):
    sys.exit(
        f"Cannot {action} system keychain credentials: {exception_summary(error)}\n"
        f"Set {ENV_API_TOKEN} for keychain-free use, or fix keychain access and run "
        f"`datalore init <notebook-url>` again."
    )


def require_keyring():
    try:
        import keyring
    except Exception as e:
        fail_keychain("load", e)

    return keyring


def notebook_credentials_key(host, owner_id, notebook_id):
    return f"{host}/notebook/{owner_id}/{notebook_id}/api_token"


def prompt_credentials(host, owner_id, notebook_id, reason=None):
    if not sys.stdin.isatty():
        if reason:
            sys.exit(
                f"{reason}, and this is a non-interactive session so a replacement "
                f"token cannot be prompted for.\n"
                f"Set {ENV_API_TOKEN}, pass --api-token-stdin, or run "
                f"`datalore init <notebook-url>` to authorize through the browser."
            )
        sys.exit(
            f"No {ENV_API_TOKEN} set and no saved credentials, and this is a "
            f"non-interactive session so a token cannot be prompted for.\n"
            f"Set {ENV_API_TOKEN}, pass --api-token-stdin, or run "
            f"`datalore init <notebook-url>` to authorize through the browser."
        )
    print(f"\n  Notebook: https://{host}/notebook/{owner_id}/{notebook_id}/\n")
    print("  Datalore API token")
    print("     Paste a token that can access this notebook.")
    print("     It can be created in the Datalore Notebook UI under Tools > API Token.")
    print()
    api_token = getpass.getpass("  Paste API token: ").strip()
    if not api_token:
        sys.exit("API token is empty.")

    return api_token


def save_credentials(host, owner_id, notebook_id, api_token):
    if get_env_api_token():
        print(f"\n  {ENV_API_TOKEN} is set; system keychain was not updated.\n")
        return
    keyring = require_keyring()
    try:
        keyring.set_password(SERVICE, notebook_credentials_key(host, owner_id, notebook_id), api_token)
    except Exception as e:
        fail_keychain("save", e)
    print("\n  Saved to system keychain.\n")


def get_keychain_credentials(host, owner_id, notebook_id):
    keyring = require_keyring()
    try:
        return keyring.get_password(SERVICE, notebook_credentials_key(host, owner_id, notebook_id))
    except Exception as e:
        fail_keychain("read", e)


def resolve_credentials_for_init(host, owner_id, notebook_id, explicit_api_token=None):
    if explicit_api_token is not None:
        if get_env_api_token():
            reject_api_token_stdin_env_conflict()
        return explicit_api_token, True, False

    env_api_token = get_env_api_token()
    if env_api_token:
        return env_api_token, False, False

    api_token = get_keychain_credentials(host, owner_id, notebook_id)
    if api_token:
        return api_token, False, True

    return prompt_credentials(host, owner_id, notebook_id), True, False


# --------------------------------------------------------------------------- #
# OAuth PKCE
# --------------------------------------------------------------------------- #

@dataclass(frozen=True)
class PkcePair:
    verifier: str
    challenge: str


@dataclass(frozen=True)
class OAuthCallbackResult:
    code: Optional[str]
    error: Optional[str]
    message: str


def base64url_without_padding(data):
    return base64.urlsafe_b64encode(data).decode("ascii").rstrip("=")


def generate_pkce_pair():
    verifier = base64url_without_padding(secrets.token_bytes(32))
    return PkcePair(verifier=verifier, challenge=calculate_pkce_challenge(verifier))


def generate_oauth_state():
    return base64url_without_padding(secrets.token_bytes(32))


def calculate_pkce_challenge(verifier):
    digest = hashlib.sha256(verifier.encode("ascii")).digest()
    return base64url_without_padding(digest)


def oauth_authorize_url(scheme, host, owner_id, notebook_id, redirect_uri, state, code_challenge):
    query = urllib.parse.urlencode(
        {
            "response_type": "code",
            "client_id": OAUTH_CLIENT_ID,
            "redirect_uri": redirect_uri,
            "scope": OAUTH_SCOPE,
            "state": state,
            "code_challenge": code_challenge,
            "code_challenge_method": "S256",
            "notebookId": f"{owner_id}/{notebook_id}",
        }
    )
    return f"{scheme}://{host}{OAUTH_API_PATH}/authorize?{query}"


def oauth_token_url(scheme, host):
    return f"{scheme}://{host}{OAUTH_API_PATH}/token"


def parse_oauth_callback(path, expected_state):
    parsed = urllib.parse.urlparse(path)
    if parsed.path != OAUTH_CALLBACK_PATH:
        return OAuthCallbackResult(None, "invalid_callback", "Unexpected OAuth callback path.")

    params = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
    state = first_query_param(params, "state")
    if state != expected_state:
        return OAuthCallbackResult(None, "state_mismatch", "OAuth callback state did not match.")

    error = first_query_param(params, "error")
    if error:
        if error == "access_denied":
            return OAuthCallbackResult(None, error, "Access was denied.")
        return OAuthCallbackResult(None, error, f"Authorization failed: {error}.")

    code = first_query_param(params, "code")
    if not code:
        return OAuthCallbackResult(None, "missing_code", "OAuth callback did not include an authorization code.")

    return OAuthCallbackResult(code, None, "Authorization succeeded.")


def first_query_param(params, name):
    values = params.get(name)
    if not values:
        return None
    return values[0]


def oauth_callback_page(result):
    if result.code and not result.error:
        title = "Datalore CLI authorization complete"
        detail = "You can return to the terminal."
    elif result.error == "access_denied":
        title = "Datalore CLI authorization denied"
        detail = "You can close this tab."
    else:
        title = "Datalore CLI authorization failed"
        detail = result.message

    return (
        "<!doctype html><html><head><meta charset=\"utf-8\">"
        f"<title>{html.escape(title)}</title>"
        "<style>body{font-family:system-ui,-apple-system,BlinkMacSystemFont,sans-serif;margin:48px;line-height:1.4;color:#1f2328}"
        "main{max-width:560px}h1{font-size:24px;margin:0 0 12px}</style></head>"
        f"<body><main><h1>{html.escape(title)}</h1><p>{html.escape(detail)}</p></main></body></html>"
    )


def create_oauth_callback_server(expected_state):
    result_holder = {"result": None}

    class OAuthCallbackHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if urllib.parse.urlparse(self.path).path != OAUTH_CALLBACK_PATH:
                # Ignore stray requests (e.g. browser favicon probes) and keep waiting for the real callback.
                self.send_error(404)
                return
            result = parse_oauth_callback(self.path, expected_state)
            result_holder["result"] = result
            body = oauth_callback_page(result).encode("utf-8")
            status = 200 if result.code and not result.error else 400
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, _format, *_args):
            if VERBOSE:
                super().log_message(_format, *_args)

    server = http.server.HTTPServer((OAUTH_CALLBACK_HOST, 0), OAuthCallbackHandler)
    server.timeout = 1
    redirect_uri = f"http://{OAUTH_CALLBACK_HOST}:{server.server_port}{OAUTH_CALLBACK_PATH}"
    return server, redirect_uri, result_holder


def wait_for_oauth_callback(server, result_holder):
    try:
        deadline = time.monotonic() + OAUTH_CALLBACK_TIMEOUT_SECONDS
        while result_holder["result"] is None and time.monotonic() < deadline:
            server.handle_request()
    finally:
        server.server_close()

    result = result_holder["result"]
    if result is None:
        return OAuthCallbackResult(None, "timeout", "Timed out waiting for browser authorization.")
    return result


def request_oauth_authorization(scheme, host, owner_id, notebook_id, pkce_pair, state):
    server, redirect_uri, result_holder = create_oauth_callback_server(state)
    authorize_url = oauth_authorize_url(scheme, host, owner_id, notebook_id, redirect_uri, state, pkce_pair.challenge)
    print("Opening browser for Datalore authorization.")
    print()
    print("If the browser does not open, you can copy and paste the following URL into a new tab of your browser:")
    print(authorize_url)
    sys.stdout.flush()
    if not webbrowser.open(authorize_url, new=1, autoraise=True):
        print("Open this URL in your browser to authorize the CLI:")
        print(authorize_url)
        sys.stdout.flush()
    result = wait_for_oauth_callback(server, result_holder)
    return redirect_uri, result


def exchange_oauth_code_for_token(scheme, host, code, redirect_uri, code_verifier):
    url = oauth_token_url(scheme, host)
    payload = {
        "grant_type": "authorization_code",
        "client_id": OAUTH_CLIENT_ID,
        "code": code,
        "redirect_uri": redirect_uri,
        "code_verifier": code_verifier,
    }
    safe_payload = dict(payload)
    safe_payload["code_verifier"] = "***"
    log_http_request("POST", url, json_body=safe_payload)
    try:
        response = requests.post(url, data=payload, timeout=default_request_timeout())
    except requests.RequestException as e:
        sys.exit(f"OAuth token exchange failed: {e}")

    body = parse_response_body(response)
    if response.status_code >= 400:
        sys.exit(format_api_error("OAuth token exchange failed", response.status_code, body))
    if not isinstance(body, dict):
        sys.exit(f"OAuth token exchange returned an unexpected response (HTTP {response.status_code}).")
    access_token = body.get("accessToken")
    token_type = body.get("tokenType")
    if not isinstance(access_token, str) or not access_token:
        sys.exit("OAuth token exchange did not return an access token.")
    if token_type != "Bearer":
        sys.exit(f"OAuth token exchange returned unsupported token type: {token_type}")
    return access_token


# --------------------------------------------------------------------------- #
# Session management
# --------------------------------------------------------------------------- #

class Session:
    __slots__ = ("host", "scheme", "owner_id", "notebook_id", "base_url", "token")

    def __init__(self, host, owner_id, notebook_id, token="", scheme="https"):
        self.host = host
        self.scheme = scheme
        self.owner_id = owner_id
        self.notebook_id = notebook_id
        self.base_url = f"{scheme}://{host}/api/notebook/v1"
        self.token = token

    def notebook_id_dict(self):
        return {"ownerId": self.owner_id, "id": self.notebook_id}


# Regex handles both /notebook/owner/id and /notebook/owner/id/anything
_URL_RE = re.compile(r"(https?)://([^/]+)/notebook/([^/]+)/([^/?#]+)")


def parse_notebook_url(url):
    """Extract (scheme, host, ownerId, notebookId) from a notebook URL."""
    m = _URL_RE.search(url)
    if not m:
        sys.exit(f"Cannot parse notebook URL: {url}\n"
                 f"Expected: https://<host>/notebook/<ownerId>/<notebookId>/...")
    return m.group(1), m.group(2), m.group(3), m.group(4)


def save_session(scheme, host, owner_id, notebook_id):
    data = {"scheme": scheme, "host": host, "ownerId": owner_id, "notebookId": notebook_id}
    try:
        Path(SESSION_FILE).write_text(json.dumps(data, indent=2) + "\n")
    except OSError as e:
        sys.exit(f"Cannot write {SESSION_FILE}: {exception_summary(e)}")


def load_session():
    """Load session from .datalore-session and resolve credentials."""
    path = Path(SESSION_FILE)
    if not path.exists():
        sys.exit(f"No {SESSION_FILE} found. Run `datalore init <notebook-url>` first.")
    try:
        data = json.loads(path.read_text())
    except OSError as e:
        sys.exit(f"Cannot read {SESSION_FILE}: {exception_summary(e)}")
    except json.JSONDecodeError as e:
        sys.exit(
            f"Cannot parse {SESSION_FILE}: {exception_summary(e)}\n"
            f"Run `datalore init <notebook-url>` again from this directory."
        )
    if not isinstance(data, dict):
        sys.exit(
            f"Invalid {SESSION_FILE}: expected a JSON object.\n"
            f"Run `datalore init <notebook-url>` again from this directory."
        )
    missing_fields = [
        field
        for field in ("host", "ownerId", "notebookId")
        if not isinstance(data.get(field), str) or not data.get(field)
    ]
    if missing_fields:
        sys.exit(
            f"Invalid {SESSION_FILE}: missing or invalid {', '.join(missing_fields)}.\n"
            f"Run `datalore init <notebook-url>` again from this directory."
        )
    scheme = data.get("scheme", "https")
    if not isinstance(scheme, str) or scheme not in ("http", "https"):
        sys.exit(
            f"Invalid {SESSION_FILE}: scheme must be 'http' or 'https'.\n"
            f"Run `datalore init <notebook-url>` again from this directory."
        )
    host = data["host"]
    owner_id = data["ownerId"]
    notebook_id = data["notebookId"]

    token = get_env_api_token()
    if not token:
        token = get_keychain_credentials(host, owner_id, notebook_id)
    if not token:
        sys.exit(f"No credentials for this notebook. Set {ENV_API_TOKEN} or run `datalore init <notebook-url>`.")

    return Session(host, owner_id, notebook_id, token, scheme)


# --------------------------------------------------------------------------- #
# HTTP helpers
# --------------------------------------------------------------------------- #

def auth_headers(session):
    return {"Authorization": f"Bearer {session.token}"}


def log_http_request(method, url, *, params=None, json_body=None, files=None):
    if not VERBOSE:
        return
    details = []
    if params:
        details.append(f"params={json.dumps(params, sort_keys=True)}")
    if json_body is not None:
        details.append(f"json={json.dumps(json_body, sort_keys=True)}")
    if files:
        details.append(f"files={','.join(files)}")
    suffix = f" ({'; '.join(details)})" if details else ""
    print(f"  {method} {url}{suffix}", file=sys.stderr)


def request_timeout(read_timeout_seconds):
    return (CONNECT_TIMEOUT_SECONDS, read_timeout_seconds)


def default_request_timeout():
    return request_timeout(API_READ_TIMEOUT_SECONDS)


def transfer_request_timeout():
    return request_timeout(TRANSFER_READ_TIMEOUT_SECONDS)


def request_timeout_for_server_wait(wait_timeout_ms, operation_count=1):
    read_timeout = (max(wait_timeout_ms, 0) * max(operation_count, 1) / 1000) + SERVER_WAIT_GRACE_SECONDS
    return request_timeout(max(API_READ_TIMEOUT_SECONDS, read_timeout))


def parse_response_body(response):
    body_text = response.text
    if response.status_code == 204 or not body_text.strip():
        return None
    try:
        return response.json()
    except ValueError:
        return body_text


def body_error_message(body):
    if isinstance(body, dict):
        return body.get("error") or body.get("message") or json.dumps(body)
    if isinstance(body, bytes):
        return body.decode("utf-8", errors="replace")[:500]
    if body is None:
        return ""
    return str(body)[:500]


def format_api_error(prefix, status, body):
    message = body_error_message(body)
    if status == 401:
        detail = f": {message}" if message else ""
        return (
            f"{prefix}: authentication failed (HTTP {status}){detail}\n"
            f"The Datalore API token is missing, invalid, or expired. "
            f"Check {ENV_API_TOKEN} or run `datalore init <notebook-url>` again from this directory."
        )
    if status == 403:
        detail = f": {message}" if message else ""
        return (
            f"{prefix}: access denied (HTTP 403){detail}\n"
            "The token is valid, but it does not have access to this notebook."
        )
    detail = f": {message}" if message else ""
    return f"{prefix} (HTTP {status}){detail}"


def api_request(session, endpoint, payload=None, raw=False, timeout=None):
    """Make an API request. Returns (http_status, parsed_body).

    When *raw* is True the response stream is returned for file downloads.
    """
    url = f"{session.base_url}{endpoint}"
    log_http_request("POST", url, json_body=payload)
    timeout = timeout or default_request_timeout()

    try:
        response = requests.post(url, headers=auth_headers(session), json=payload, timeout=timeout, stream=raw)
    except requests.RequestException as e:
        return 0, str(e)

    if raw and response.status_code < 400:
        return response.status_code, response

    body = parse_response_body(response)
    if response.status_code < 400 and isinstance(body, str):
        sys.exit(f"Unexpected response (HTTP {response.status_code}):\n{body[:500]}")
    return response.status_code, body


def api_post(session, endpoint, payload, timeout=None):
    """POST with JSON payload; exit on error."""
    status, body = api_request(session, endpoint, payload, timeout=timeout)
    if status == 0:
        sys.exit(f"API request failed: {body}")
    if status >= 400:
        sys.exit(format_api_error("API error", status, body))
    return body


def api_upload(session, endpoint, file_path, query_params, timeout=None):
    """Multipart file upload."""
    url = f"{session.base_url}{endpoint}"
    log_http_request("POST", url, params=query_params, files=["file"])
    timeout = timeout or transfer_request_timeout()
    try:
        with open(file_path, "rb") as f:
            response = requests.post(
                url,
                headers=auth_headers(session),
                params=query_params,
                files={"file": (os.path.basename(file_path), f)},
                timeout=timeout,
            )
    except requests.RequestException as e:
        sys.exit(f"Upload failed: {e}")

    body_text = response.text
    if response.status_code >= 400:
        sys.exit(format_api_error("Upload failed", response.status_code, parse_response_body(response)))
    try:
        return json.loads(body_text) if body_text.strip() else None
    except json.JSONDecodeError:
        return body_text


def parse_json_argument(value, argument_name):
    """Parse inline JSON, @file JSON, or '-' JSON from stdin."""
    if value == "-":
        text = sys.stdin.read()
    elif value.startswith("@"):
        text = Path(value[1:]).read_text()
    else:
        text = value
    try:
        parsed = json.loads(text)
    except json.JSONDecodeError as e:
        sys.exit(f"Invalid JSON for {argument_name}: {e}")
    if not isinstance(parsed, dict):
        sys.exit(f"{argument_name} must be a JSON object.")
    return parsed


def print_json(body):
    print(json.dumps(body, indent=2))


# --------------------------------------------------------------------------- #
# Formatting helpers
# --------------------------------------------------------------------------- #

def format_status(status):
    return f"[{status}]"


def format_cell_line(cell):
    """One-line summary: position cellId type first_line."""
    pos = cell.get("position", "?")
    cid = cell.get("cellId", "?")
    ctype = cell.get("cellType", "?")
    source = cell.get("source", "") or ""
    first_line = source.split("\n", 1)[0]
    if len(first_line) > 70:
        first_line = first_line[:67] + "..."
    return f"  {pos:>3}  {cid:<10} {ctype:<10} {first_line}"


def format_outputs(data):
    """Format cell outputs/run result for human display."""
    parts = []
    stream_texts = set()

    status = data.get("executionStatus", "")
    count = data.get("executionCount", "")
    if status:
        parts.append(f"{format_status(status)} execution #{count}")

    stdout = data.get("stdout")
    if stdout:
        text = stdout.rstrip("\n")
        parts.append(text)
        stream_texts.add(text)
        if data.get("stdoutTruncated"):
            parts.append("[stdout truncated]")

    stderr = data.get("stderr")
    if stderr:
        text = stderr.rstrip("\n")
        parts.append(f"STDERR: {text}")
        stream_texts.add(text)
        if data.get("stderrTruncated"):
            parts.append("[stderr truncated]")

    error_msg = data.get("errorMessage")
    error_tb = data.get("errorTraceback")
    if error_msg:
        parts.append(f"Error: {error_msg}")
    if error_tb:
        parts.append(error_tb.rstrip("\n"))
        if data.get("errorTracebackTruncated"):
            parts.append("[traceback truncated]")

    outputs = data.get("outputs") or []
    plot_count = 0
    for out in outputs:
        otype = out.get("outputType", "")
        text = out.get("text")
        if otype in ("TEXT", "LAST_EXPRESSION"):
            if text:
                rendered = text.rstrip("\n")
                if rendered not in stream_texts:
                    parts.append(rendered)
        elif otype in ("MARKDOWN", "LATEX", "TSV"):
            if text:
                parts.append(text.rstrip("\n"))
        elif otype == "TABLE":
            if text:
                # Strip HTML tags for a rough text rendering
                clean = re.sub(r"<[^>]+>", " ", text)
                clean = re.sub(r"\s+", " ", clean).strip()
                if len(clean) > 2000:
                    clean = clean[:2000] + "... (truncated)"
                parts.append(clean)
        elif otype == "HTML":
            if text:
                clean = re.sub(r"<[^>]+>", " ", text)
                clean = re.sub(r"\s+", " ", clean).strip()
                if len(clean) > 2000:
                    clean = clean[:2000] + "... (truncated)"
                parts.append(clean)
        elif otype in ("PLOT", "SVG", "PLOTLY", "VEGA"):
            plot_count += 1
        elif text:
            parts.append(text.rstrip("\n"))

    if plot_count:
        parts.append(f"[{plot_count} plot output{'s' if plot_count > 1 else ''}]")

    return "\n".join(parts)


def format_run_result(result):
    """Format a runResult (from create/edit/run)."""
    if result is None:
        return ""
    return format_outputs(result)


# --------------------------------------------------------------------------- #
# Wait / polling
# --------------------------------------------------------------------------- #

def is_terminal(status):
    return status in TERMINAL_STATUSES


def wait_for_completion(session, cell_id, timeout):
    """Poll /cell/outputs until a terminal status or timeout."""
    payload = {"notebookId": session.notebook_id_dict(), "cellId": cell_id}
    deadline = time.monotonic() + timeout
    interval = 0.5

    while time.monotonic() < deadline:
        time.sleep(interval)
        elapsed = time.monotonic() + timeout - deadline
        print(f"  Waiting for cell {cell_id}... [{elapsed:.1f}s]", file=sys.stderr, end="\r")
        body = api_post(session, "/cell/outputs", payload)
        status = body.get("executionStatus", "")
        if is_terminal(status):
            print(file=sys.stderr)  # clear the waiting line
            return body
        interval = min(interval * 2, MAX_POLL_INTERVAL)

    print(file=sys.stderr)
    return None  # timeout


def api_wait_timeout_ms(timeout_s):
    return min(max(int(timeout_s), 0) * 1000, MAX_API_TIMEOUT_MS)


# --------------------------------------------------------------------------- #
# Stdin handling
# --------------------------------------------------------------------------- #

def read_source(args_source=None):
    """Read cell source from --source flag or stdin.

    --source takes priority over stdin when both are available.
    """
    if args_source is not None:
        return args_source
    if sys.stdin.isatty():
        return None
    return sys.stdin.read()


# --------------------------------------------------------------------------- #
# Command handlers
# --------------------------------------------------------------------------- #

def cmd_init(args):
    scheme, host, owner_id, notebook_id = parse_notebook_url(args.url)
    if args.api_token_stdin and get_env_api_token():
        reject_api_token_stdin_env_conflict()
    explicit_api_token = read_api_token_from_stdin() if args.api_token_stdin else None

    if explicit_api_token is not None or get_env_api_token():
        api_token, should_save_credentials, can_renew_keychain_token = resolve_credentials_for_init(
            host,
            owner_id,
            notebook_id,
            explicit_api_token,
        )
        initialize_session_with_token(
            scheme,
            host,
            owner_id,
            notebook_id,
            api_token,
            should_save_credentials,
            can_renew_keychain_token,
        )
        return

    api_token = get_keychain_credentials(host, owner_id, notebook_id)
    if api_token:
        initialize_session_with_saved_token(scheme, host, owner_id, notebook_id, api_token)
        return

    initialize_session_with_oauth(scheme, host, owner_id, notebook_id)


def initialize_session_with_token(
    scheme,
    host,
    owner_id,
    notebook_id,
    api_token,
    should_save_credentials,
    can_renew_keychain_token,
):
    status, body = check_init_token(scheme, host, owner_id, notebook_id, api_token)
    if status == 401 and can_renew_keychain_token:
        print("\n  Saved API token is invalid or expired. Enter a replacement token.\n", file=sys.stderr)
        api_token = prompt_credentials(
            host,
            owner_id,
            notebook_id,
            "Saved API token is invalid or expired",
        )
        should_save_credentials = True
        status, body = check_init_token(scheme, host, owner_id, notebook_id, api_token)
    if status == 0:
        sys.exit(f"API request failed: {body}")
    if status >= 400:
        sys.exit(format_api_error("API error", status, body))

    if should_save_credentials:
        save_credentials(host, owner_id, notebook_id, api_token)

    save_initialized_session(scheme, host, owner_id, notebook_id)


def initialize_session_with_saved_token(scheme, host, owner_id, notebook_id, api_token):
    status, body = check_init_token(scheme, host, owner_id, notebook_id, api_token)
    if status == 0:
        sys.exit(f"API request failed: {body}")
    if status == 401:
        print("\n  Saved API token is invalid or expired. Starting browser authorization.\n", file=sys.stderr)
        initialize_session_with_oauth(scheme, host, owner_id, notebook_id)
        return
    if status >= 400:
        sys.exit(format_api_error("API error", status, body))

    save_initialized_session(scheme, host, owner_id, notebook_id)


def check_init_token(scheme, host, owner_id, notebook_id, api_token):
    session = Session(host, owner_id, notebook_id, api_token, scheme)
    payload = {"notebookId": session.notebook_id_dict()}
    return api_request(session, "/cells", payload)


def initialize_session_with_oauth(scheme, host, owner_id, notebook_id):
    pkce_pair = generate_pkce_pair()
    state = generate_oauth_state()
    redirect_uri, callback = request_oauth_authorization(scheme, host, owner_id, notebook_id, pkce_pair, state)
    if callback.error:
        sys.exit(callback.message)

    api_token = exchange_oauth_code_for_token(scheme, host, callback.code, redirect_uri, pkce_pair.verifier)
    session = Session(host, owner_id, notebook_id, api_token, scheme)
    payload = {"notebookId": session.notebook_id_dict()}
    status, body = api_request(session, "/cells", payload)
    if status == 0:
        sys.exit(f"API request failed: {body}")
    if status >= 400:
        sys.exit(format_api_error("API error", status, body))

    save_credentials(host, owner_id, notebook_id, api_token)
    save_initialized_session(scheme, host, owner_id, notebook_id)


def save_initialized_session(scheme, host, owner_id, notebook_id):
    save_session(scheme, host, owner_id, notebook_id)
    print(f"Session saved for notebook {notebook_id} on {host}")
    print(f"  Owner:    {owner_id}")
    print(f"  Notebook: {notebook_id}")
    print(f"  File:     {SESSION_FILE}")


def cmd_cells(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict()}
    if args.worksheet_index is not None:
        payload["worksheetIndex"] = args.worksheet_index
    if args.include_outputs:
        payload["includeOutputs"] = True
    body = api_post(session, "/cells", payload)

    if args.json:
        print_json(body)
        return

    cells = body.get("cellsWithOutputs") if args.include_outputs else body.get("cells")
    cells = cells or []
    if not cells:
        print("No cells in notebook.")
        return

    for cell in cells:
        print(format_cell_line(cell))
        if args.include_outputs:
            status = cell.get("executionStatus")
            if status:
                print(f"       status: {format_status(status)} #{cell.get('executionCount', '')}")
        if args.full:
            source = cell.get("source", "") or ""
            for line in source.split("\n"):
                print(f"         | {line}")
            if args.include_outputs:
                output_text = format_outputs(cell)
                if output_text:
                    print("       outputs:")
                    for line in output_text.split("\n"):
                        print(f"         > {line}")
            print()

    if body.get("outputsTruncated"):
        print(
            f"Outputs truncated from cell {body.get('outputsTruncatedFromCellId')}. "
            "Use `datalore cell outputs <id>` for full output.",
            file=sys.stderr,
        )


def cmd_cells_run(args):
    session = load_session()
    timeout_ms = args.timeout_ms
    payload = {
        "notebookId": session.notebook_id_dict(),
        "cellIds": args.cell_ids,
    }
    if args.stop_on_error is not None:
        payload["stopOnError"] = args.stop_on_error
    if timeout_ms is not None:
        payload["timeoutMs"] = timeout_ms

    body = api_post(
        session,
        "/cells/run",
        payload,
        timeout=request_timeout_for_server_wait(timeout_ms, len(args.cell_ids)) if timeout_ms is not None else None,
    )

    if args.json:
        print_json(body)
        return

    exit_code = 0
    for result in body.get("results", []):
        cell_id = result.get("cellId", "?")
        status = result.get("executionStatus", "")
        print(f"Cell {cell_id}: {format_status(status)}")
        output_text = format_outputs(result)
        if output_text:
            print(output_text)
        if status == "ERROR":
            exit_code = max(exit_code, 1)
        elif status == "TIMEOUT":
            exit_code = max(exit_code, 2)

    if body.get("stopped"):
        print(f"Stopped: {body.get('stoppedReason')}", file=sys.stderr)
    if exit_code:
        sys.exit(exit_code)


