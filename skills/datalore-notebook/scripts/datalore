def cmd_cell_delete(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict(), "cellId": args.cell_id}
    status, body = api_request(session, "/cell/delete", payload)
    if status == 0:
        sys.exit(f"Failed to delete cell: {body}")
    if status >= 400:
        sys.exit(format_api_error(f"Failed to delete cell {args.cell_id}", status, body))
    if args.json:
        print_json({"deleted": True, "cellId": args.cell_id})
        return
    print(f"Deleted cell {args.cell_id}")


def cmd_cell_update_control(args):
    session = load_session()
    control = parse_json_argument(args.control_json, "--control-json")

    if args.wait:
        args.run = True

    payload = {
        "notebookId": session.notebook_id_dict(),
        "cellId": args.cell_id,
        "control": control,
    }
    if args.run:
        payload["run"] = True
        payload["timeoutMs"] = api_wait_timeout_ms(args.timeout)

    body = api_post(
        session,
        "/cell/controls/update",
        payload,
        timeout=request_timeout_for_server_wait(payload["timeoutMs"]) if args.run else None,
    )

    if args.json:
        print_json(body)
        return

    print(f"Updated controls for cell {body.get('cellId', args.cell_id)}")
    run_result = body.get("runResult")
    if run_result:
        status = run_result.get("executionStatus", "")
        output_text = format_run_result(run_result)
        if output_text:
            print(output_text)
        if args.wait and not is_terminal(status):
            result = wait_for_completion(session, args.cell_id, args.timeout)
            if result is None:
                print(f"Timeout waiting for cell {args.cell_id}", file=sys.stderr)
                sys.exit(2)
            print(format_outputs(result))
            if result.get("executionStatus") == "ERROR":
                sys.exit(1)
        elif status == "ERROR":
            sys.exit(1)


def cmd_definitions(args):
    session = load_session()
    payload = {
        "notebookId": session.notebook_id_dict(),
        "cellId": args.cell_id,
        "line": args.line,
        "column": args.column,
    }
    body = api_post(session, "/definitions", payload)

    if args.json:
        print_json(body)
        return

    if not body.get("found"):
        print("Definition not found.")
        sys.exit(1)

    location = []
    if body.get("filePath"):
        location.append(body["filePath"])
    if body.get("cellId"):
        location.append(f"cell {body['cellId']}")
    if body.get("line") is not None and body.get("column") is not None:
        location.append(f"{body['line']}:{body['column']}")
    print("Definition: " + " ".join(location))


def cmd_files(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict()}
    if args.directory:
        payload["directory"] = args.directory
    body = api_post(session, "/files", payload)

    if args.json:
        print_json(body)
        return

    files = body.get("files", [])
    if not files:
        print("No files.")
        return
    for f in files:
        ftype = f.get("type", "")
        name = f.get("name", "")
        size = f.get("fileSize", 0)
        indicator = "/" if ftype == "FOLDER" else ""
        if ftype == "FILE":
            print(f"  {size:>10}  {name}")
        else:
            print(f"  {'<dir>':>10}  {name}/")


def cmd_file_read(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict(), "filePath": args.path}
    status, body = api_request(session, "/file", payload, raw=True, timeout=transfer_request_timeout())
    if status == 0:
        sys.exit(f"Failed to read file {args.path}: {body}")
    if status >= 400:
        sys.exit(format_api_error(f"Failed to read file {args.path}", status, body))
    try:
        with body:
            for chunk in body.iter_content(chunk_size=DOWNLOAD_CHUNK_SIZE_BYTES):
                if chunk:
                    sys.stdout.buffer.write(chunk)
    except requests.RequestException as e:
        sys.exit(f"Failed to read file {args.path}: {e}")


def cmd_file_text(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict(), "filePath": args.path}
    if args.encoding:
        payload["encoding"] = args.encoding
    if args.max_bytes is not None:
        payload["maxBytes"] = args.max_bytes
    if args.max_lines is not None:
        payload["maxLines"] = args.max_lines

    body = api_post(session, "/file/read", payload)

    if args.json:
        print_json(body)
        return

    content = body.get("content", "")
    sys.stdout.write(content)
    if content and not content.endswith("\n"):
        sys.stdout.write("\n")
    if body.get("truncated"):
        print(
            f"[truncated after {body.get('bytesRead')} bytes, {body.get('linesRead')} lines]",
            file=sys.stderr,
        )


def cmd_file_upload(args):
    session = load_session()
    if not os.path.isfile(args.local_path):
        sys.exit(f"File not found: {args.local_path}")
    params = {
        "ownerId": session.owner_id,
        "notebookId": session.notebook_id,
    }
    if args.directory:
        params["directory"] = args.directory
    result = api_upload(session, "/file/upload", args.local_path, params, timeout=transfer_request_timeout())
    if args.json:
        print_json(result)
        return
    if isinstance(result, dict):
        print(f"Uploaded: {result.get('fileName', args.local_path)}")
    else:
        print(f"Uploaded: {args.local_path}")


