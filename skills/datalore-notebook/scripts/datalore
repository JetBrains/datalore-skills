def cmd_workspace_database_query(args):
    session = load_session()
    command_label = "datalore workspace database query"
    require_workspace_resource_session(session, command_label, "FULL")
    status, body, headers = workspace_api_post_raw(
        session,
        "/database/query",
        args.query,
        params={
            "workspaceId": session.workspace_id,
            "databaseId": args.database_id,
            "name": args.name,
        },
        timeout=transfer_request_timeout(),
        content_type="text/plain",
    )
    if status == 0:
        sys.exit(f"Failed to execute database query: {body}")
    if status >= 400:
        sys.exit(format_api_error("Failed to execute database query", status, body, headers, session))
    try:
        with body:
            for chunk in body.iter_content(chunk_size=DOWNLOAD_CHUNK_SIZE_BYTES):
                if chunk:
                    sys.stdout.buffer.write(chunk)
    except requests.RequestException as e:
        sys.exit(f"Failed to execute database query: {e}")


def cmd_files(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict()}
    if args.directory:
        payload["directory"] = args.directory
    body = notebook_api_post(session, "/files", payload)

    if args.json:
        print_json(body)
        return

    files = body.get("files", [])
    if not files:
        print("No files.")
        return
    for f in files:
        ftype = f.get("type", "")
        name = f.get("name", "")
        size = f.get("fileSize", 0)
        indicator = "/" if ftype == "FOLDER" else ""
        if ftype == "FILE":
            print(f"  {size:>10}  {name}")
        else:
            print(f"  {'<dir>':>10}  {name}/")


def cmd_file_read(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict(), "filePath": args.path}
    status, body, headers = notebook_api_request(session, "/file", payload, raw=True, timeout=transfer_request_timeout())
    if status == 0:
        sys.exit(f"Failed to read file {args.path}: {body}")
    if status >= 400:
        sys.exit(format_api_error(f"Failed to read file {args.path}", status, body, headers, session))
    try:
        with body:
            for chunk in body.iter_content(chunk_size=DOWNLOAD_CHUNK_SIZE_BYTES):
                if chunk:
                    sys.stdout.buffer.write(chunk)
    except requests.RequestException as e:
        sys.exit(f"Failed to read file {args.path}: {e}")


def cmd_file_text(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict(), "filePath": args.path}
    if args.encoding:
        payload["encoding"] = args.encoding
    if args.max_bytes is not None:
        payload["maxBytes"] = args.max_bytes
    if args.max_lines is not None:
        payload["maxLines"] = args.max_lines

    body = notebook_api_post(session, "/file/read", payload)

    if args.json:
        print_json(body)
        return

    content = body.get("content", "")
    sys.stdout.write(content)
    if content and not content.endswith("\n"):
        sys.stdout.write("\n")
    if body.get("truncated"):
        print(
            f"[truncated after {body.get('bytesRead')} bytes, {body.get('linesRead')} lines]",
            file=sys.stderr,
        )


def cmd_file_upload(args):
    session = load_session()
    if not os.path.isfile(args.local_path):
        sys.exit(f"File not found: {args.local_path}")
    params = {
        "ownerId": session.owner_id,
        "notebookId": session.notebook_id,
    }
    if args.directory:
        params["directory"] = args.directory
    result = api_upload(session, "/file/upload", args.local_path, params, timeout=transfer_request_timeout())
    if args.json:
        print_json(result)
        return
    if isinstance(result, dict):
        print(f"Uploaded: {result.get('fileName', args.local_path)}")
    else:
        print(f"Uploaded: {args.local_path}")


