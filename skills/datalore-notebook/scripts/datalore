RESOURCE_API_PATHS = {
    "databases": "/api/databases/v1",
    "datasources": "/api/datasources/v1",
    "environments": "/api/environments/v1",
    "git-repositories": "/api/git-repositories/v1",
    "ssh-keys": "/api/ssh-keys/v1",
}

RESOURCE_TYPE_LABELS = {
    "databases": "database",
    "datasources": "datasource",
    "environments": "environment",
    "git-repositories": "git repository",
    "ssh-keys": "SSH key",
}

RESOURCE_ATTACHMENT_CAPABILITIES = {
    "databases": {
        "attached": True,
        "get-attached": True,
        "attach": True,
        "update-attachment": False,
        "detach": True,
    },
    "datasources": {
        "attached": True,
        "get-attached": True,
        "attach": True,
        "update-attachment": True,
        "detach": True,
    },
    "environments": {
        "attached": True,
        "get-attached": True,
        "attach": True,
        "update-attachment": False,
        "detach": True,
    },
    "git-repositories": {
        "attached": True,
        "get-attached": True,
        "attach": True,
        "update-attachment": True,
        "detach": True,
    },
    "ssh-keys": {
        "attached": False,
        "get-attached": False,
        "attach": False,
        "update-attachment": False,
        "detach": False,
    },
}

RESOURCE_TYPES_WITH_CUSTOM_ATTACHMENT_OPTIONS = {"datasources", "git-repositories"}


def resource_api_post(session, resource_type, endpoint, payload=None, params=None, timeout=None):
    """Make a POST request to a resource API endpoint."""
    api_path = RESOURCE_API_PATHS.get(resource_type)
    if api_path is None:
        sys.exit(f"Unknown resource type: {resource_type}")
    return api_expect_success(
        "Resource API error",
        session,
        *api_request(session, api_path, endpoint, method="POST", payload=payload, params=params, timeout=timeout),
    )


def get_workspace_scope_id(session):
    """Build a ResourceScopeId JSON for the current workspace."""
    owner_id, workspace_internal_id = parse_slash_id(session.workspace_id, "workspaceId")
    return {
        "type": "WORKSPACE",
        "workspaceId": {
            "ownerId": owner_id,
            "internalId": workspace_internal_id,
        }
    }


def get_workspace_id_payload(session):
    """Build a VfsWorkspaceId JSON for the current workspace."""
    owner_id, workspace_internal_id = parse_slash_id(session.workspace_id, "workspaceId")
    return {
        "ownerId": owner_id,
        "internalId": workspace_internal_id,
    }


def resource_request(scope_id, resource):
    """Build a ResourceRequest JSON body."""
    return {"scopeId": scope_id, "resource": resource}


def resource_attachment_request(resource_id, file_id, attachment_options=None):
    payload = {
        "resourceId": resource_id,
        "fileId": file_id,
    }
    if attachment_options is not None:
        payload["attachmentOptions"] = attachment_options
    return payload


def format_resource_line(res, resource_type):
    """Format one resource for human-readable listing."""
    rid = res.get("id", "?")
    if isinstance(rid, dict):
        rid = rid.get("id", rid.get("internalId", "?"))
    name = res.get("name", "?")
    extra = []
    if resource_type == "databases":
        driver = res.get("driverRef", {})
        if isinstance(driver, dict):
            extra.append(f"[{driver.get('id', '?')}]")
    if resource_type == "git-repositories":
        url = res.get("url", "")
        if url:
            extra.append(f"({url})")
    if resource_type == "ssh-keys":
        fingerprint = res.get("sha256Fingerprint", res.get("md5Fingerprint", ""))
        if fingerprint:
            extra.append(f"[{fingerprint}]")
    if resource_type == "environments":
        variables = res.get("variables", [])
        if isinstance(variables, list):
            extra.append(f"({len(variables)} vars)")
    if resource_type == "datasources":
        kind = res.get("kind", "")
        if kind:
            extra.append(f"[{kind}]")
    suffix = " ".join(extra)
    if suffix:
        suffix = " " + suffix
    return f"  {rid:<36} {name}{suffix}"


def format_attachment_options_summary(attached_resource, resource_type):
    options = attached_resource.get("options") or attached_resource.get("attachmentOptions")
    if not isinstance(options, dict) or not options:
        return ""

    if resource_type == "datasources":
        parts = []
        mountpoint = options.get("mountpoint")
        if mountpoint:
            parts.append(f"mount={mountpoint}")
        parts.append("pass-to-env" if options.get("passToEnv") else "no-pass-to-env")
        parts.append("read-only" if options.get("readOnly") else "read-write")
        return " " + " ".join(parts)

    if resource_type == "git-repositories":
        reference = options.get("reference")
        if isinstance(reference, dict):
            parts = []
            reference_name = reference.get("reference")
            reference_type = reference.get("type")
            if reference_name:
                parts.append(f"ref={reference_name}")
            if reference_type:
                parts.append(f"[{reference_type}]")
            if parts:
                return " " + " ".join(parts)

    return f" options={json.dumps(options, sort_keys=True)}"


def format_attached_resource_line(attached_resource, resource_type):
    resource = attached_resource.get("resource", attached_resource)
    return format_resource_line(resource, resource_type) + format_attachment_options_summary(attached_resource, resource_type)


def format_usage_line(usage):
    """Format one resource usage entry."""
    entity = usage.get("vfsEntityId", {})
    if isinstance(entity, dict):
        eid = f"{entity.get('ownerId', '?')}/{entity.get('internalId', '?')}"
    else:
        eid = str(entity)
    name = usage.get("name", "?")
    return f"  {eid:<40} {name}"


def extract_vfs_id(value):
    if isinstance(value, str):
        return value
    if not isinstance(value, dict):
        return "?"
    owner_id = value.get("ownerId")
    internal_id = value.get("internalId") or value.get("id")
    if isinstance(owner_id, str) and isinstance(internal_id, str):
        return f"{owner_id}/{internal_id}"
    for key in ("id", "entityId", "entity", "notebook", "folder", "staticReport", "interactiveReport"):
        nested = value.get(key)
        if nested is not None and nested is not value:
            nested_id = extract_vfs_id(nested)
            if nested_id != "?":
                return nested_id
    return "?"


def format_workspace_line(workspace_view):
    workspace = workspace_view.get("workspace", {})
    workspace_id = extract_vfs_id(workspace.get("id", workspace))
    access_level = workspace_view.get("accessLevel", "?")
    name = workspace.get("name", "?")
    flags = []
    if workspace_view.get("isSharedWithTeam"):
        flags.append("team")
    if workspace_view.get("isCreatedFromGit"):
        flags.append("git")
    suffix = f" [{' '.join(flags)}]" if flags else ""
    return f"  {workspace_id:<30} {access_level:<8} {name}{suffix}"


VFS_ENTITY_PAYLOAD_KEYS = {
    "NOTEBOOK": "notebook",
    "FOLDER": "folder",
    "STATIC_REPORT": "staticReport",
    "INTERACTIVE_REPORT": "interactiveReport",
}


def unwrap_vfs_entity(value):
    if not isinstance(value, dict):
        return None, {}
    entity = value.get("entity", value)
    if not isinstance(entity, dict):
        return None, {}

    entity_type = entity.get("type")
    payload_key = VFS_ENTITY_PAYLOAD_KEYS.get(entity_type)
    if payload_key and isinstance(entity.get(payload_key), dict):
        return entity_type, entity[payload_key]

    for candidate_type, candidate_key in VFS_ENTITY_PAYLOAD_KEYS.items():
        if isinstance(entity.get(candidate_key), dict):
            return candidate_type, entity[candidate_key]
    return entity_type, entity


def infer_workspace_entry_type(value):
    entity_type, entity = unwrap_vfs_entity(value)
    if entity_type:
        return entity_type
    if not entity:
        return "ENTRY"
    if "entityId" in entity:
        return "FOLDER"
    if "kernelType" in entity or "kernelName" in entity:
        return "NOTEBOOK"
    return "ENTRY"


def format_workspace_entry_line(entry):
    entity_type, entity = unwrap_vfs_entity(entry)
    entity_type = entity_type or infer_workspace_entry_type(entity)
    access_level = entry.get("accessLevel") or entry.get("personalAccessLevel") or "?"
    entity_id = extract_vfs_id(entity)
    name = entity.get("name", "?")
    return f"  {entity_type:<10} {entity_id:<30} {access_level:<8} {name}"


def format_workspace_report_line(report):
    entity_type, entity = unwrap_vfs_entity(report.get("vfsFile", report))
    report_type = "STATIC" if entity_type == "STATIC_REPORT" or entity.get("reportFormat") == "STATIC" else "INTERACTIVE"
    entity_id = extract_vfs_id(entity)
    name = entity.get("name", "?")
    access_level = report.get("accessLevel") or report.get("personalAccessLevel") or "?"
    return f"  {report_type:<12} {entity_id:<30} {access_level:<8} {name}"


def format_breadcrumb_line(entry):
    entity_type, entity = unwrap_vfs_entity(entry)
    entity_type = entity_type or infer_workspace_entry_type(entity)
    entity_id = extract_vfs_id(entity)
    name = entity.get("name", "?")
    return f"  {entity_type:<10} {entity_id:<30} {name}"


def print_workspace_entries(entries):
    if not entries:
        print("No entries.")
        return
    for entry in entries:
        print(format_workspace_entry_line(entry))


def print_workspace_reports(reports):
    if not reports:
        print("No reports.")
        return
    for report in reports:
        print(format_workspace_report_line(report))


# --------------------------------------------------------------------------- #
# Formatting helpers
# --------------------------------------------------------------------------- #

def format_status(status):
    return f"[{status}]"


def format_cell_line(cell):
    """One-line summary: position cellId type first_line."""
    pos = cell.get("position", "?")
    cid = cell.get("cellId", "?")
    ctype = cell.get("cellType", "?")
    source = cell.get("source", "") or ""
    first_line = source.split("\n", 1)[0]
    if len(first_line) > 70:
        first_line = first_line[:67] + "..."
    return f"  {pos:>3}  {cid:<10} {ctype:<10} {first_line}"


def format_outputs(data):
    """Format cell outputs/run result for human display."""
    parts = []
    stream_texts = set()

    status = data.get("executionStatus", "")
    count = data.get("executionCount", "")
    if status:
        parts.append(f"{format_status(status)} execution #{count}")

    stdout = data.get("stdout")
    if stdout:
        text = stdout.rstrip("\n")
        parts.append(text)
        stream_texts.add(text)
        if data.get("stdoutTruncated"):
            parts.append("[stdout truncated]")

    stderr = data.get("stderr")
    if stderr:
        text = stderr.rstrip("\n")
        parts.append(f"STDERR: {text}")
        stream_texts.add(text)
        if data.get("stderrTruncated"):
            parts.append("[stderr truncated]")

    error_msg = data.get("errorMessage")
    error_tb = data.get("errorTraceback")
    if error_msg:
        parts.append(f"Error: {error_msg}")
    if error_tb:
        parts.append(error_tb.rstrip("\n"))
        if data.get("errorTracebackTruncated"):
            parts.append("[traceback truncated]")

    outputs = data.get("outputs") or []
    plot_count = 0
    for out in outputs:
        otype = out.get("outputType", "")
        text = out.get("text")
        if otype in ("TEXT", "LAST_EXPRESSION"):
            if text:
                rendered = text.rstrip("\n")
                if rendered not in stream_texts:
                    parts.append(rendered)
        elif otype in ("MARKDOWN", "LATEX", "TSV"):
            if text:
                parts.append(text.rstrip("\n"))
        elif otype == "TABLE":
            if text:
                # Strip HTML tags for a rough text rendering
                clean = re.sub(r"<[^>]+>", " ", text)
                clean = re.sub(r"\s+", " ", clean).strip()
                if len(clean) > 2000:
                    clean = clean[:2000] + "... (truncated)"
                parts.append(clean)
        elif otype == "HTML":
            if text:
                clean = re.sub(r"<[^>]+>", " ", text)
                clean = re.sub(r"\s+", " ", clean).strip()
                if len(clean) > 2000:
                    clean = clean[:2000] + "... (truncated)"
                parts.append(clean)
        elif otype in ("PLOT", "SVG", "PLOTLY", "VEGA"):
            plot_count += 1
        elif text:
            parts.append(text.rstrip("\n"))

    if plot_count:
        parts.append(f"[{plot_count} plot output{'s' if plot_count > 1 else ''}]")

    return "\n".join(parts)


def format_run_result(result):
    """Format a runResult (from create/edit/run)."""
    if result is None:
        return ""
    return format_outputs(result)


# --------------------------------------------------------------------------- #
# Wait / polling
# --------------------------------------------------------------------------- #

def is_terminal(status):
    return status in TERMINAL_STATUSES


def wait_for_completion(session, cell_id, timeout):
    """Poll /cell/outputs until a terminal status or timeout."""
    payload = {"notebookId": session.notebook_id_dict(), "cellId": cell_id}
    deadline = time.monotonic() + timeout
    interval = 0.5

    while time.monotonic() < deadline:
        time.sleep(interval)
        elapsed = time.monotonic() + timeout - deadline
        print(f"  Waiting for cell {cell_id}... [{elapsed:.1f}s]", file=sys.stderr, end="\r")
        body = notebook_api_post(session, "/cell/outputs", payload)
        status = body.get("executionStatus", "")
        if is_terminal(status):
            print(file=sys.stderr)  # clear the waiting line
            return body
        interval = min(interval * 2, MAX_POLL_INTERVAL)

    print(file=sys.stderr)
    return None  # timeout


def api_wait_timeout_ms(timeout_s):
    return min(max(int(timeout_s), 0) * 1000, MAX_API_TIMEOUT_MS)


# --------------------------------------------------------------------------- #
# Stdin handling
# --------------------------------------------------------------------------- #

def read_source(args_source=None):
    """Read cell source from --source flag or stdin.

    --source takes priority over stdin when both are available.
    """
    if args_source is not None:
        return args_source
    if sys.stdin.isatty():
        return None
    return sys.stdin.read()


# --------------------------------------------------------------------------- #
# Command handlers
# --------------------------------------------------------------------------- #

def require_scope_workspace_id(scope, workspace_id):
    if scope in WORKSPACE_SCOPES and not workspace_id:
        sys.exit(f"--workspace-id is required for --scope {scope}.")
    if scope not in WORKSPACE_SCOPES and workspace_id:
        sys.exit(f"--workspace-id is only supported with workspace scope: {WORKSPACE_SCOPE}.")


def notebook_context_for_scope(scope, notebook_id, owner_id, internal_id):
    if not notebook_id:
        return owner_id, internal_id
    if scope not in WORKSPACE_SCOPES:
        sys.exit(f"--notebook-id is only supported with workspace scope: {WORKSPACE_SCOPE}.")
    return parse_slash_id(notebook_id, "notebookId")


def cmd_init(args):
    scope = getattr(args, "scope", NOTEBOOK_API_SCOPE)
    access = parse_auth_access(getattr(args, "access", DEFAULT_AUTH_ACCESS.lower()))
    scheme, host, owner_id, notebook_id, parsed_workspace_id = parse_target_url(args.url, scope)
    workspace_id = getattr(args, "workspace_id", None) or parsed_workspace_id
    require_scope_workspace_id(scope, workspace_id)
    owner_id, notebook_id = notebook_context_for_scope(
        scope,
        getattr(args, "notebook_id", None),
        owner_id,
        notebook_id,
    )
    if args.api_token_stdin and get_env_api_token():
        reject_api_token_stdin_env_conflict()
    explicit_api_token = read_api_token_from_stdin() if args.api_token_stdin else None

    if explicit_api_token is not None or get_env_api_token():
        require_scope_compatibility(scheme, host, scope)
        api_token, should_save_credentials, can_renew_keychain_token = resolve_credentials_for_init(
            host,
            owner_id,
            notebook_id,
            explicit_api_token,
            scope,
            workspace_id,
            access,
        )
        initialize_session_with_token(
            scheme,
            host,
            owner_id,
            notebook_id,
            scope,
            workspace_id,
            access,
            api_token,
            should_save_credentials,
            can_renew_keychain_token,
        )
        return

    api_token = get_keychain_credentials(host, owner_id, notebook_id, scope, workspace_id, access)
    if api_token:
        initialize_session_with_saved_token(scheme, host, owner_id, notebook_id, scope, workspace_id, access, api_token)
        return

    initialize_session_with_oauth(scheme, host, owner_id, notebook_id, scope, workspace_id, access)


def cmd_logout(args):
    if args.url:
        scope = getattr(args, "scope", NOTEBOOK_API_SCOPE)
        access = parse_auth_access(getattr(args, "access", DEFAULT_AUTH_ACCESS.lower()))
        _scheme, host, owner_id, notebook_id, parsed_workspace_id = parse_target_url(args.url, scope)
        workspace_id = getattr(args, "workspace_id", None) or parsed_workspace_id
        require_scope_workspace_id(scope, workspace_id)
    else:
        _scheme, host, owner_id, notebook_id, scope, workspace_id, access = load_session_identity()
    delete_credentials(host, owner_id, notebook_id, scope, workspace_id, access)
    delete_session()
    print(f"Logged out from scope {scope} on {host}")


def initialize_session_with_token(
        scheme,
        host,
        owner_id,
        notebook_id,
        scope,
        workspace_id,
        access,
        api_token,
        should_save_credentials,
        can_renew_keychain_token,
):
    status, body, headers = check_init_token(scheme, host, owner_id, notebook_id, api_token, scope, workspace_id, access)
    if status not in (0, 401):
        require_matching_workspace_agent_skill_version(scope, headers)
    if status == 401 and can_renew_keychain_token:
        print("\n  Saved API token is invalid or expired. Enter a replacement token.\n", file=sys.stderr)
        api_token = prompt_credentials(
            host,
            owner_id,
            notebook_id,
            scope,
            workspace_id,
            access,
            "Saved API token is invalid or expired",
        )
        should_save_credentials = True
        status, body, headers = check_init_token(scheme, host, owner_id, notebook_id, api_token, scope, workspace_id, access)
        if status not in (0, 401):
            require_matching_workspace_agent_skill_version(scope, headers)
    if status == 0:
        sys.exit(f"API request failed: {body}")
    if status >= 400:
        session = Session(host, owner_id, notebook_id, api_token, scheme, scope, workspace_id, access)
        sys.exit(format_api_error("API error", status, body, headers, session))

    if should_save_credentials:
        save_credentials(host, owner_id, notebook_id, api_token, scope, workspace_id, access)

    save_initialized_session(scheme, host, owner_id, notebook_id, scope, workspace_id, access)


def initialize_session_with_saved_token(scheme, host, owner_id, notebook_id, scope, workspace_id, access, api_token):
    status, body, headers = check_init_token(scheme, host, owner_id, notebook_id, api_token, scope, workspace_id, access)
    if status == 0:
        sys.exit(f"API request failed: {body}")
    if status == 401:
        print("\n  Saved API token is invalid or expired. Starting browser authorization.\n", file=sys.stderr)
        initialize_session_with_oauth(scheme, host, owner_id, notebook_id, scope, workspace_id, access)
        return
    if status >= 400:
        session = Session(host, owner_id, notebook_id, api_token, scheme, scope, workspace_id, access)
        sys.exit(format_api_error("API error", status, body, headers, session))

    save_initialized_session(scheme, host, owner_id, notebook_id, scope, workspace_id, access)


def check_init_token(scheme, host, owner_id, notebook_id, api_token, scope=NOTEBOOK_API_SCOPE, workspace_id=None, access=DEFAULT_AUTH_ACCESS):
    session = Session(host, owner_id, notebook_id, api_token, scheme, scope, workspace_id, access)
    if scope in NOTEBOOK_SCOPES:
        payload = {"notebookId": session.notebook_id_dict()}
        return notebook_api_request(session, "/cells", payload)
    if scope == USER_BASIC_SCOPE:
        return api_request(session, USER_PUBLIC_API_PATH, "/workspaces", method="GET")
    if scope in WORKSPACE_SCOPES:
        return api_request(
            session,
            WORKSPACES_API_PATH,
            "/entries",
            method="GET",
            params={"workspaceId": session.workspace_id},
        )
    sys.exit(f"Unsupported scope: {scope}")


def initialize_session_with_oauth(scheme, host, owner_id, notebook_id, scope=NOTEBOOK_API_SCOPE, workspace_id=None, access=DEFAULT_AUTH_ACCESS):
    require_scope_compatibility(scheme, host, scope)
    pkce_pair = generate_pkce_pair()
    state = generate_oauth_state()
    redirect_uri, callback = request_oauth_authorization(
        scheme,
        host,
        owner_id,
        notebook_id,
        workspace_id,
        scope,
        access,
        pkce_pair,
        state,
    )
    if callback.error:
        sys.exit(callback.message)

    api_token = exchange_oauth_code_for_token(scheme, host, callback.code, redirect_uri, pkce_pair.verifier)
    status, body, headers = check_init_token(scheme, host, owner_id, notebook_id, api_token, scope, workspace_id, access)
    if status == 0:
        sys.exit(f"API request failed: {body}")
    if status >= 400:
        session = Session(host, owner_id, notebook_id, api_token, scheme, scope, workspace_id, access)
        sys.exit(format_api_error("API error", status, body, headers, session))

    save_credentials(host, owner_id, notebook_id, api_token, scope, workspace_id, access)
    save_initialized_session(scheme, host, owner_id, notebook_id, scope, workspace_id, access)


def save_initialized_session(scheme, host, owner_id, notebook_id, scope=NOTEBOOK_API_SCOPE, workspace_id=None, access=DEFAULT_AUTH_ACCESS):
    save_session(scheme, host, owner_id, notebook_id, scope, workspace_id, access)
    print(f"Session saved for scope {scope} on {host}")
    if owner_id:
        print(f"  Owner:    {owner_id}")
    if notebook_id:
        print(f"  Notebook: {notebook_id}")
    if workspace_id:
        print(f"  Workspace: {workspace_id}")
        print(f"  Access:    {auth_access_display(access)}")
    print(f"  File:     {SESSION_FILE}")


def cmd_cells(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict()}
    if args.worksheet_index is not None:
        payload["worksheetIndex"] = args.worksheet_index
    if args.include_outputs:
        payload["includeOutputs"] = True
    body = notebook_api_post(session, "/cells", payload)

    if args.json:
        print_json(body)
        return

    cells = body.get("cellsWithOutputs") if args.include_outputs else body.get("cells")
    cells = cells or []
    if not cells:
        print("No cells in notebook.")
        return

    for cell in cells:
        print(format_cell_line(cell))
        if args.include_outputs:
            status = cell.get("executionStatus")
            if status:
                print(f"       status: {format_status(status)} #{cell.get('executionCount', '')}")
        if args.full:
            source = cell.get("source", "") or ""
            for line in source.split("\n"):
                print(f"         | {line}")
            if args.include_outputs:
                output_text = format_outputs(cell)
                if output_text:
                    print("       outputs:")
                    for line in output_text.split("\n"):
                        print(f"         > {line}")
            print()

    if body.get("outputsTruncated"):
        print(
            f"Outputs truncated from cell {body.get('outputsTruncatedFromCellId')}. "
            "Use `datalore notebook cell outputs <id>` for full output.",
            file=sys.stderr,
        )


def cmd_cells_run(args):
    session = load_session()
    timeout_ms = args.timeout_ms
    payload = {
        "notebookId": session.notebook_id_dict(),
        "cellIds": args.cell_ids,
    }
    if args.stop_on_error is not None:
        payload["stopOnError"] = args.stop_on_error
    if timeout_ms is not None:
        payload["timeoutMs"] = timeout_ms

    body = notebook_api_post(
        session,
        "/cells/run",
        payload,
        timeout=request_timeout_for_server_wait(timeout_ms, len(args.cell_ids)) if timeout_ms is not None else None,
    )

    if args.json:
        print_json(body)
        return

    exit_code = 0
    for result in body.get("results", []):
        cell_id = result.get("cellId", "?")
        status = result.get("executionStatus", "")
        print(f"Cell {cell_id}: {format_status(status)}")
        output_text = format_outputs(result)
        if output_text:
            print(output_text)
        if status == "ERROR":
            exit_code = max(exit_code, 1)
        elif status == "TIMEOUT":
            exit_code = max(exit_code, 2)

    if body.get("stopped"):
        print(f"Stopped: {body.get('stoppedReason')}", file=sys.stderr)
    if exit_code:
        sys.exit(exit_code)


def cmd_worksheet_create(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict()}
    if args.name:
        payload["name"] = args.name
    if args.worksheet_index is not None:
        payload["worksheetIndex"] = args.worksheet_index

    body = notebook_api_post(session, "/worksheet/create", payload)

    if args.json:
        print_json(body)
        return

    print(
        f"Created worksheet {body.get('worksheetId', '?')} "
        f"at index {body.get('worksheetIndex', '?')}: {body.get('name', '?')}"
    )
    print(f"First cell: {body.get('firstCellId', '?')}")


def parse_json_array_argument(value, argument_name):
    """Parse inline JSON, @file JSON, or '-' JSON from stdin as an array."""
    if value == "-":
        text = sys.stdin.read()
    elif value.startswith("@"):
        text = Path(value[1:]).read_text()
    else:
        text = value
    try:
        parsed = json.loads(text)
    except json.JSONDecodeError as e:
        sys.exit(f"Invalid JSON for {argument_name}: {e}")
    if not isinstance(parsed, list):
        sys.exit(f"{argument_name} must be a JSON array.")
    return parsed


def report_request(args, endpoint, payload, required_access="READ"):
    session = load_session()
    command_label = f"datalore notebook report {args.report_command}"
    require_notebook_resource_session(session, command_label, required_access=required_access)
    payload["notebookId"] = session.notebook_id_dict()
    body = notebook_api_post(session, endpoint, payload)
    print_json(body)


def cmd_report_get(args):
    report_request(args, "/report", {})


def cmd_report_replace(args):
    report_request(args, "/report/replace", {"tabs": parse_json_array_argument(args.tabs_json, "--tabs-json")}, "FULL")


def cmd_report_operation(args):
    operation = {"type": args.report_operation_type}
    for argument, field in args.report_operation_fields.items():
        value = getattr(args, argument)
        if value is not None:
            operation[field] = value
    report_request(args, "/report/operations", {"operations": [operation]}, "FULL")


def cmd_report_upsert_cell(args):
    operation = {
        "type": "UPSERT_CELL",
        "rowId": args.row_id,
        "cell": parse_json_argument(args.cell_json, "--cell-json"),
    }
    report_request(args, "/report/operations", {"operations": [operation]}, "FULL")


def cmd_report_publish(args):
