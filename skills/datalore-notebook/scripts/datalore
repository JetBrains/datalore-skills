    "info": cmd_workspace_info,
    "entries": cmd_workspace_entries,
    "reports": cmd_workspace_reports,
    "file": cmd_workspace_file,
    "breadcrumbs": cmd_workspace_breadcrumbs,
    "folder": cmd_workspace_folder,
    "folder-entries": cmd_workspace_folder_entries,
    "mkdir": cmd_workspace_mkdir,
    "create-notebook": cmd_workspace_create_notebook,
    "rename": cmd_workspace_rename,
    "move": cmd_workspace_move,
    "move-to-trash": cmd_workspace_move_to_trash,
    "remove-from-trash": cmd_workspace_remove_from_trash,
    "restore-from-trash": cmd_workspace_restore_from_trash,
    "empty-trash": cmd_workspace_empty_trash,
}

DATABASE_COMMAND_MAP = {
    "query": cmd_workspace_database_query,
}


# --------------------------------------------------------------------------- #
# Resource commands
# --------------------------------------------------------------------------- #

def _get_resource_type_from_command(command):
    """Extract the resource type from a type-specific command name."""
    return RESOURCE_API_PATHS.get(command)


def workspace_resource_command_prefix(resource_type):
    return f"datalore workspace {resource_type}"


def cmd_resource_list(args):
    """List all resources of a given type in the current workspace."""
    session = load_session()
    require_workspace_resource_session(session, f"{workspace_resource_command_prefix(args.resource_type)} list", "READ")
    resource_type = args.resource_type
    scope_id = get_workspace_scope_id(session)
    body = resource_api_post(session, resource_type, "/all", payload=scope_id)
    if getattr(args, "json", False):
        print_json(body)
        return
    if not body:
        print(f"No {resource_type} found.")
        return
    for res in body:
        print(format_resource_line(res, resource_type))


def cmd_resource_get(args):
    """Get a specific resource by ID."""
    session = load_session()
    require_workspace_resource_session(session, f"{workspace_resource_command_prefix(args.resource_type)} get", "READ")
    resource_type = args.resource_type
    body = resource_api_post(session, resource_type, "/get", payload=args.resource_id)
    print_json(body)


def cmd_database_drivers(args):
    """List available database drivers."""
    session = load_session()
    require_workspace_resource_session(session, "datalore workspace databases drivers", "READ")
    body = resource_api_post(session, "databases", "/get-all-drivers")
    if getattr(args, "json", False):
        print_json(body)
        return
    if not body:
        print("No database drivers found.")
        return
    for driver in body:
        driver_id = driver.get("id", {})
        if isinstance(driver_id, dict):
            driver_id = driver_id.get("id", "?")
        name = driver.get("name", "?")
        source = "predefined" if driver.get("predefined") else "custom"
        print(f"  {driver_id:<24} {name} [{source}]")


def cmd_resource_create(args):
    """Create a new resource."""
    session = load_session()
    require_workspace_resource_session(session, f"{workspace_resource_command_prefix(args.resource_type)} create", "FULL")
    resource_type = args.resource_type
    scope_id = get_workspace_scope_id(session)
    resource_data = build_resource_create_payload(session, args)
    payload = resource_request(scope_id, resource_data)
    body = resource_api_post(session, resource_type, "/create", payload=payload)
    if getattr(args, "json", False):
        print_json(body)
    else:
        print(f"Resource created successfully.")


def cmd_resource_update(args):
    """Update an existing resource."""
    session = load_session()
    require_workspace_resource_session(session, f"{workspace_resource_command_prefix(args.resource_type)} update", "FULL")
    resource_type = args.resource_type
    resource_data = parse_json_argument(args.resource_json, "resource")
    resource_data = normalize_resource_update_payload(resource_type, resource_data)
    body = resource_api_post(session, resource_type, "/update", payload=resource_data)
    if getattr(args, "json", False):
        print_json(body)
    else:
        print(f"Resource updated successfully.")


def cmd_resource_delete(args):
    """Delete a resource by ID."""
    session = load_session()
    require_workspace_resource_session(session, f"{workspace_resource_command_prefix(args.resource_type)} delete", "FULL")
    resource_type = args.resource_type
    body = resource_api_post(session, resource_type, "/delete", payload=args.resource_id)
    if getattr(args, "json", False):
        print_json(body)
    else:
        print(f"Resource deleted successfully.")


def cmd_resource_search(args):
    """Search resources by name."""
    session = load_session()
    require_workspace_resource_session(session, f"{workspace_resource_command_prefix(args.resource_type)} search", "READ")
    resource_type = args.resource_type
    search_request = {
        "query": args.query,
        "workspaces": [get_workspace_id_payload(session)],
    }
    body = resource_api_post(session, resource_type, "/search", payload=search_request)
    if getattr(args, "json", False):
        print_json(body)
        return
    if not body:
        print(f"No {resource_type} found matching '{args.query}'.")
        return
    for result in body:
        res = result.get("resource", result)
        print(format_resource_line(res, resource_type))


def cmd_resource_usage(args):
    """List where a resource is used."""
    session = load_session()
    require_workspace_resource_session(session, f"{workspace_resource_command_prefix(args.resource_type)} usage", "READ")
    resource_type = args.resource_type
    params = {"matchDuplicates": "true"} if getattr(args, "match_duplicates", False) else None
    body = resource_api_post(session, resource_type, "/usage-list", payload=args.resource_id, params=params)
    if getattr(args, "json", False):
        print_json(body)
        return
    if not body:
        print("No usages found.")
        return
    for usage in body:
        print(format_usage_line(usage))


def cmd_resource_clone(args):
    """Clone a resource to new workspace scopes."""
    session = load_session()
    require_workspace_resource_session(session, f"{workspace_resource_command_prefix(args.resource_type)} clone", "FULL")
    resource_type = args.resource_type
    clone_request = {
        "scopes": [get_workspace_scope_id(session)],
    }
    if args.new_name:
        clone_request["newName"] = args.new_name
    params = {"resource_id": args.resource_id}
    body = resource_api_post(session, resource_type, "/clone", payload=clone_request, params=params)
    print_json(body)


def current_notebook_file_id(session, command_label, notebook_id=None):
    if notebook_id:
        owner_id, internal_id = parse_slash_id(notebook_id, "notebookId")
        return {
            "ownerId": owner_id,
            "id": internal_id,
        }
    if session.owner_id and session.notebook_id:
        return {
            "ownerId": session.owner_id,
            "id": session.notebook_id,
        }
    sys.exit(f"`{command_label}` requires notebook identity; pass --notebook-id <ownerId>/<notebookId>.")


def parse_attachment_options_argument(value, argument_name):
    if value is None:
        return None
    return parse_json_argument(value, argument_name)


def require_resource_attachment_support(resource_type, command_name):
    capabilities = RESOURCE_ATTACHMENT_CAPABILITIES.get(resource_type, {})
    if capabilities.get(command_name):
        return
    sys.exit(f"{RESOURCE_TYPE_LABELS.get(resource_type, resource_type)} resources do not support `{command_name}`.")


def cmd_resource_attached(args):
    session = load_session()
    command_label = f"datalore notebook {args.resource_type} attached"
    require_resource_attachment_support(args.resource_type, "attached")
    require_notebook_resource_session(session, command_label)
    file_id = current_notebook_file_id(session, command_label, args.notebook_id)
    body = resource_api_post(session, args.resource_type, "/attached-list", payload=file_id)
    if getattr(args, "json", False):
        print_json(body)
        return
    if not body:
        print(f"No {args.resource_type} attached to {extract_vfs_id(file_id)}.")
        return
    for attached_resource in body:
        print(format_attached_resource_line(attached_resource, args.resource_type))


def cmd_resource_get_attached(args):
    session = load_session()
    command_label = f"datalore notebook {args.resource_type} get-attached"
    require_resource_attachment_support(args.resource_type, "get-attached")
    require_notebook_resource_session(session, command_label)
    file_id = current_notebook_file_id(session, command_label, args.notebook_id)
    body = resource_api_post(
        session,
        args.resource_type,
        "/attached",
        payload=resource_attachment_request(args.resource_id, file_id),
    )
    print_json(body)


def cmd_resource_attach(args):
    session = load_session()
    command_label = f"datalore notebook {args.resource_type} attach"
    require_resource_attachment_support(args.resource_type, "attach")
    require_notebook_resource_session(session, command_label, NOTEBOOK_WITH_WORKSPACE_VIEW_SCOPE, "CREATE")
    attachment_options = parse_attachment_options_argument(
        getattr(args, "attachment_options_json", None),
        "--attachment-options",
    )
    file_id = current_notebook_file_id(session, command_label, args.notebook_id)
    payload = resource_attachment_request(args.resource_id, file_id, attachment_options)
    resource_api_post(
        session,
        args.resource_type,
        "/attach",
        payload=payload,
    )
    result = {
        "attached": True,
        "resourceId": args.resource_id,
        "fileId": file_id,
    }
    if attachment_options is not None:
        result["attachmentOptions"] = attachment_options
    if getattr(args, "json", False):
        print_json(result)
        return
    print(
        f"Attached {RESOURCE_TYPE_LABELS.get(args.resource_type, args.resource_type)} "
        f"{args.resource_id} to {extract_vfs_id(file_id)}."
    )


def cmd_resource_update_attachment(args):
    session = load_session()
    command_label = f"datalore notebook {args.resource_type} update-attachment"
    require_resource_attachment_support(args.resource_type, "update-attachment")
    require_notebook_resource_session(session, command_label, NOTEBOOK_WITH_WORKSPACE_VIEW_SCOPE, "CREATE")
    attachment_options = parse_attachment_options_argument(args.attachment_options_json, "--attachment-options")
    file_id = current_notebook_file_id(session, command_label, args.notebook_id)
    resource_api_post(
        session,
        args.resource_type,
        "/update-attachment",
        payload=resource_attachment_request(args.resource_id, file_id, attachment_options),
    )
    result = {
        "updated": True,
        "resourceId": args.resource_id,
        "fileId": file_id,
        "attachmentOptions": attachment_options,
    }
    if getattr(args, "json", False):
        print_json(result)
        return
    print(
        f"Updated attachment for {RESOURCE_TYPE_LABELS.get(args.resource_type, args.resource_type)} "
        f"{args.resource_id} on {extract_vfs_id(file_id)}."
    )


def cmd_resource_detach(args):
    session = load_session()
    command_label = f"datalore notebook {args.resource_type} detach"
    require_resource_attachment_support(args.resource_type, "detach")
    require_notebook_resource_session(session, command_label, NOTEBOOK_WITH_WORKSPACE_VIEW_SCOPE, "CREATE")
    file_id = current_notebook_file_id(session, command_label, args.notebook_id)
    resource_api_post(
        session,
        args.resource_type,
        "/detach",
        payload=resource_attachment_request(args.resource_id, file_id),
    )
    result = {
        "detached": True,
        "resourceId": args.resource_id,
        "fileId": file_id,
    }
    if getattr(args, "json", False):
        print_json(result)
        return
    print(
        f"Detached {RESOURCE_TYPE_LABELS.get(args.resource_type, args.resource_type)} "
        f"{args.resource_id} from {extract_vfs_id(file_id)}."
    )


WORKSPACE_RESOURCE_COMMAND_MAP = {
    "list": cmd_resource_list,
    "get": cmd_resource_get,
    "drivers": cmd_database_drivers,
    "create": cmd_resource_create,
    "update": cmd_resource_update,
    "delete": cmd_resource_delete,
    "search": cmd_resource_search,
    "usage": cmd_resource_usage,
    "clone": cmd_resource_clone,
}

NOTEBOOK_RESOURCE_COMMAND_MAP = {
    "attached": cmd_resource_attached,
    "get-attached": cmd_resource_get_attached,
    "attach": cmd_resource_attach,
    "update-attachment": cmd_resource_update_attachment,
    "detach": cmd_resource_detach,
}


def main():
    global NOTEBOOK_ID_OVERRIDE, WORKSPACE_ID_OVERRIDE, VERBOSE
    preflight_keyring_access()
    parser = build_parser()
    args = parser.parse_args()

    VERBOSE = getattr(args, "verbose", False)
    NOTEBOOK_ID_OVERRIDE = getattr(args, "notebook_id", None) if args.command == "notebook" else None
    WORKSPACE_ID_OVERRIDE = getattr(args, "workspace_id", None) if args.command == "workspace" else None

    if not args.command:
        parser.print_help()
        sys.exit(1)

    # Top-level commands
    if args.command in COMMAND_MAP:
        COMMAND_MAP[args.command](args)
        return

    if args.command == "workspace":
        if not args.workspace_command:
            parser.parse_args(["workspace", "--help"])
            return
        if args.workspace_command == "database":
            if not args.database_command:
                parser.parse_args(["workspace", "database", "--help"])
                return
            handler = DATABASE_COMMAND_MAP.get(args.database_command)
            if handler:
                handler(args)
            else:
                sys.exit(f"Unknown workspace database command: {args.database_command}")
            return
        if args.workspace_command in RESOURCE_API_PATHS:
            if not args.resource_command:
                parser.parse_args(["workspace", args.workspace_command, "--help"])
                return
            args.resource_type = args.workspace_command
            handler = WORKSPACE_RESOURCE_COMMAND_MAP.get(args.resource_command)
            if handler:
                handler(args)
            else:
                sys.exit(f"Unknown workspace {args.workspace_command} command: {args.resource_command}")
            return
        handler = WORKSPACE_COMMAND_MAP.get(args.workspace_command)
        if handler:
            handler(args)
        else:
            sys.exit(f"Unknown workspace command: {args.workspace_command}")
        return

    if args.command == "notebook":
        if not args.notebook_command:
            parser.parse_args(["notebook", "--help"])
            return
        if args.notebook_command in RESOURCE_ATTACHMENT_CAPABILITIES:
            if not args.notebook_resource_command:
                parser.parse_args(["notebook", args.notebook_command, "--help"])
                return
            args.resource_type = args.notebook_command
            handler = NOTEBOOK_RESOURCE_COMMAND_MAP.get(args.notebook_resource_command)
            if handler:
                handler(args)
            else:
                sys.exit(f"Unknown notebook {args.notebook_command} command: {args.notebook_resource_command}")
            return
        if args.notebook_command == "files":
            cmd_files(args)
            return
        if args.notebook_command == "attached-databases":
            cmd_attached_databases(args)
            return
        if args.notebook_command == "definitions":
            cmd_definitions(args)
            return
        if args.notebook_command == "cells":
            if args.cells_command == "run":
                cmd_cells_run(args)
            else:
                cmd_cells(args)
            return
        if args.notebook_command == "cell":
            if not args.cell_command:
                parser.parse_args(["notebook", "cell", "--help"])
                return
            handler = CELL_COMMAND_MAP.get(args.cell_command)
            if handler:
                handler(args)
            else:
                sys.exit(f"Unknown notebook cell command: {args.cell_command}")
            return
        if args.notebook_command == "file":
            if not args.file_command:
                parser.parse_args(["notebook", "file", "--help"])
                return
            handler = FILE_COMMAND_MAP.get(args.file_command)
            if handler:
                handler(args)
            else:
                sys.exit(f"Unknown notebook file command: {args.file_command}")
            return
        if args.notebook_command == "db":
            if not args.db_command:
                parser.parse_args(["notebook", "db", "--help"])
                return
            handler = DB_COMMAND_MAP.get(args.db_command)
            if handler:
                handler(args)
            else:
                sys.exit(f"Unknown notebook db command: {args.db_command}")
            return
        if args.notebook_command == "kernel":
            if not args.kernel_command:
                parser.parse_args(["notebook", "kernel", "--help"])
                return
            handler = KERNEL_COMMAND_MAP.get(args.kernel_command)
            if handler:
                handler(args)
            else:
                sys.exit(f"Unknown notebook kernel command: {args.kernel_command}")
            return
        if args.notebook_command == "agent":
            if not args.agent_command:
                parser.parse_args(["notebook", "agent", "--help"])
                return
            handler = AGENT_COMMAND_MAP.get(args.agent_command)
            if handler:
                handler(args)
            else:
                sys.exit(f"Unknown notebook agent command: {args.agent_command}")
            return
        if args.notebook_command == "worksheet":
            if not args.worksheet_command:
                parser.parse_args(["notebook", "worksheet", "--help"])
                return
            handler = WORKSHEET_COMMAND_MAP.get(args.worksheet_command)
            if handler:
                handler(args)
            else:
                sys.exit(f"Unknown notebook worksheet command: {args.worksheet_command}")
            return
        if args.notebook_command == "report":
            if not args.report_command:
                parser.parse_args(["notebook", "report", "--help"])
                return
            if args.report_command == "get":
                cmd_report_get(args)
            elif args.report_command == "replace":
                cmd_report_replace(args)
            elif args.report_command == "upsert-cell":
                cmd_report_upsert_cell(args)
            elif args.report_command == "publish":
                cmd_report_publish(args)
            else:
                cmd_report_operation(args)
            return
        sys.exit(f"Unknown notebook command: {args.notebook_command}")
        return

    sys.exit(f"Unknown command: {args.command}")


if __name__ == "__main__":
    main()
