        "type": args.type,
        "mode": args.mode,
        "fullWidth": args.full_width,
        "canDownloadAndEditCopy": args.can_download_and_edit_copy,
    }
    if args.computation_mode is not None:
        payload["computationMode"] = args.computation_mode
    report_request(args, "/report/publish", payload, "FULL")


def cmd_cell_get(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict(), "cellId": args.cell_id}
    body = notebook_api_post(session, "/cell", payload)

    if args.json:
        print_json(body)
        return

    cell = body.get("cell", body)
    print(format_cell_line(cell))
    output_text = format_outputs(cell)
    if output_text:
        print(output_text)


def get_cell_type(session, cell_id):
    payload = {"notebookId": session.notebook_id_dict(), "cellId": cell_id}
    body = notebook_api_post(session, "/cell", payload)
    cell = body.get("cell", body)
    cell_type = cell.get("cellType")
    if not cell_type:
        sys.exit(f"Cannot determine cell type for {cell_id}.")
    return cell_type


def cmd_cell_create(args):
    session = load_session()
    stdin_used_for_json = args.data_json == "-" or args.control_json == "-"
    source = getattr(args, "source", None) if stdin_used_for_json else read_source(getattr(args, "source", None))

    cell_type = args.type
    can_execute = cell_type in CREATE_RUNNABLE_CELL_TYPES
    if args.run and not can_execute:
        sys.exit(f"{cell_type} cells cannot be executed; omit --run.")
    should_run = args.run or (args.wait and can_execute)

    payload = {
        "notebookId": session.notebook_id_dict(),
        "cellType": cell_type,
    }
    if source is not None:
        payload["source"] = source

    # Cell type-specific data
    data = parse_json_argument(args.data_json, "--data-json") if args.data_json else {}
    if args.control_json:
        if data:
            sys.exit("--data-json and --control-json are mutually exclusive.")
        data = {"control": parse_json_argument(args.control_json, "--control-json")}

    if cell_type == "CODE" and not data:
        data["language"] = args.language
    elif cell_type == "SQL" and not data:
        if args.database_id:
            data["databaseId"] = args.database_id
        if args.variable_name:
            data["variableName"] = args.variable_name
    elif cell_type == "CONTROL" and not data:
        sys.exit("CONTROL cells require --control-json or --data-json.")
    if data:
        payload["data"] = data

    if args.after_cell_id:
        payload["afterCellId"] = args.after_cell_id
    if args.before_cell_id:
        payload["beforeCellId"] = args.before_cell_id
    if args.after_cell_id and args.before_cell_id:
        sys.exit("--after and --before are mutually exclusive.")

    if should_run:
        payload["run"] = True
        payload["timeoutMs"] = api_wait_timeout_ms(args.timeout)

    body = notebook_api_post(
        session,
        "/cell/create",
        payload,
        timeout=request_timeout_for_server_wait(payload["timeoutMs"]) if should_run else None,
    )

    if args.json:
        print_json(body)
        return

    cell_id = body.get("cellId", "?")
    print(f"Created cell {cell_id}")

    run_result = body.get("runResult")
    if run_result:
        status = run_result.get("executionStatus", "")
        output_text = format_run_result(run_result)
        if output_text:
            print(output_text)

        if args.wait and not is_terminal(status):
            result = wait_for_completion(session, cell_id, args.timeout)
            if result is None:
                print(f"Timeout waiting for cell {cell_id}", file=sys.stderr)
                sys.exit(2)
            print(format_outputs(result))
            if result.get("executionStatus") == "ERROR":
                sys.exit(1)
        elif status == "ERROR":
            sys.exit(1)
    elif args.wait and should_run:
        result = wait_for_completion(session, cell_id, args.timeout)
        if result is None:
            print(f"Timeout waiting for cell {cell_id}", file=sys.stderr)
            sys.exit(2)
        print(format_outputs(result))
        if result.get("executionStatus") == "ERROR":
            sys.exit(1)


def cmd_cell_edit(args):
    session = load_session()
    if args.data_json == "-" and args.source is None:
        sys.exit("--data-json - requires --source because stdin is used for JSON.")
    source = read_source(getattr(args, "source", None))

    if source is None:
        sys.exit("No source provided. Pipe source via stdin or use --source.")

    cell_type = get_cell_type(session, args.cell_id) if args.wait or args.run else None
    can_execute = cell_type in EDIT_RUNNABLE_CELL_TYPES
    if args.run and not can_execute:
        sys.exit(f"{cell_type} cells cannot be executed; omit --run.")
    should_run = args.run or (args.wait and can_execute)

    payload = {
        "notebookId": session.notebook_id_dict(),
        "cellId": args.cell_id,
        "newContent": source,
    }

    data = parse_json_argument(args.data_json, "--data-json") if args.data_json else {}
    if args.database_id:
        data["databaseId"] = args.database_id
    if args.variable_name:
        data["variableName"] = args.variable_name
    if data:
        payload["data"] = data

    if should_run:
        payload["run"] = True
        payload["timeoutMs"] = api_wait_timeout_ms(args.timeout)

    body = notebook_api_post(
        session,
        "/cell/edit",
        payload,
        timeout=request_timeout_for_server_wait(payload["timeoutMs"]) if should_run else None,
    )

    if args.json:
        print_json(body)
        return

    cell_id = body.get("cellId", args.cell_id)
    applied = body.get("applied", False)
    print(f"Edited cell {cell_id} (applied: {applied})")

    run_result = body.get("runResult")
    if run_result:
        status = run_result.get("executionStatus", "")
        output_text = format_run_result(run_result)
        if output_text:
            print(output_text)

        if args.wait and not is_terminal(status):
            result = wait_for_completion(session, cell_id, args.timeout)
            if result is None:
                print(f"Timeout waiting for cell {cell_id}", file=sys.stderr)
                sys.exit(2)
            print(format_outputs(result))
            if result.get("executionStatus") == "ERROR":
                sys.exit(1)
        elif status == "ERROR":
            sys.exit(1)
    elif args.wait and should_run:
        result = wait_for_completion(session, cell_id, args.timeout)
        if result is None:
            print(f"Timeout waiting for cell {cell_id}", file=sys.stderr)
            sys.exit(2)
        print(format_outputs(result))
        if result.get("executionStatus") == "ERROR":
            sys.exit(1)


def cmd_cell_run(args):
    session = load_session()
    timeout_ms = api_wait_timeout_ms(args.timeout)
    payload = {
        "notebookId": session.notebook_id_dict(),
        "cellId": args.cell_id,
        "timeoutMs": timeout_ms,
    }
    body = notebook_api_post(session, "/cell/run", payload, timeout=request_timeout_for_server_wait(timeout_ms))

    if args.json:
        print_json(body)
        return

    status = body.get("executionStatus", "")
    output_text = format_outputs(body)
    if output_text:
        print(output_text)

    if args.wait and not is_terminal(status):
        result = wait_for_completion(session, args.cell_id, args.timeout)
        if result is None:
            print(f"Timeout waiting for cell {args.cell_id}", file=sys.stderr)
            sys.exit(2)
        print(format_outputs(result))
        if result.get("executionStatus") == "ERROR":
            sys.exit(1)
    elif status == "ERROR":
        sys.exit(1)


def cmd_cell_outputs(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict(), "cellId": args.cell_id}
    body = notebook_api_post(session, "/cell/outputs", payload)

    if args.json:
        print_json(body)
        return

    print(format_outputs(body))


def cmd_cell_delete(args):
    session = load_session()
    payload = {"notebookId": session.notebook_id_dict(), "cellId": args.cell_id}
    status, body, headers = notebook_api_request(session, "/cell/delete", payload)
    if status == 0:
        sys.exit(f"Failed to delete cell: {body}")
    if status >= 400:
        sys.exit(format_api_error(f"Failed to delete cell {args.cell_id}", status, body, headers, session))
    if args.json:
        print_json({"deleted": True, "cellId": args.cell_id})
        return
    print(f"Deleted cell {args.cell_id}")


def cmd_cell_update_control(args):
    session = load_session()
    control = parse_json_argument(args.control_json, "--control-json")

    if args.wait:
        args.run = True

    payload = {
        "notebookId": session.notebook_id_dict(),
        "cellId": args.cell_id,
        "control": control,
    }
    if args.run:
        payload["run"] = True
        payload["timeoutMs"] = api_wait_timeout_ms(args.timeout)

    body = notebook_api_post(
        session,
        "/cell/controls/update",
        payload,
        timeout=request_timeout_for_server_wait(payload["timeoutMs"]) if args.run else None,
    )

    if args.json:
        print_json(body)
        return

    print(f"Updated controls for cell {body.get('cellId', args.cell_id)}")
    run_result = body.get("runResult")
    if run_result:
        status = run_result.get("executionStatus", "")
        output_text = format_run_result(run_result)
        if output_text:
            print(output_text)
        if args.wait and not is_terminal(status):
            result = wait_for_completion(session, args.cell_id, args.timeout)
            if result is None:
                print(f"Timeout waiting for cell {args.cell_id}", file=sys.stderr)
                sys.exit(2)
            print(format_outputs(result))
            if result.get("executionStatus") == "ERROR":
                sys.exit(1)
        elif status == "ERROR":
            sys.exit(1)


def cmd_definitions(args):
    session = load_session()
    payload = {
        "notebookId": session.notebook_id_dict(),
        "cellId": args.cell_id,
        "line": args.line,
        "column": args.column,
    }
    body = notebook_api_post(session, "/definitions", payload)

    if args.json:
        print_json(body)
        return

    if not body.get("found"):
        print("Definition not found.")
        sys.exit(1)

    location = []
    if body.get("filePath"):
        location.append(body["filePath"])
    if body.get("cellId"):
        location.append(f"cell {body['cellId']}")
    if body.get("line") is not None and body.get("column") is not None:
        location.append(f"{body['line']}:{body['column']}")
    print("Definition: " + " ".join(location))


